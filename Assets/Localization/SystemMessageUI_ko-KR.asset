      m_Items: []
  - m_Id: 7800000000000
    m_Localized: "\uAC8C\uC784 \uC138\uC158\uC774 \uC544\uC9C1 \uC0B4\uC544\uC788\uC5B4 \uB2E4\uC2DC \uC5F0\uACB0\uD569\uB2C8\uB2E4."
