      m_Items: []
  - m_Id: 7600000000000
    m_Localized: "\uAC8C\uC784 \uC138\uC158\uC774 \uC885\uB8CC\uB418\uC5B4 \uBA54\uC778 \uD654\uBA74\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
