      m_Items: []
  - m_Id: 7700000000000
    m_Localized: "\uAC8C\uC784 \uC11C\uBC84 \uC751\uB2F5\uC744 \uD655\uC778\uD558\uC9C0 \uBABB\uD574 \uBA54\uC778 \uD654\uBA74\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
