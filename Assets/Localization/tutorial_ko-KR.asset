  m_TableData:
  - m_Id: 31254896640
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC \uB118\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 63110635520
    m_Localized: "\uB9C8\uB098 \uBC14\uB97C \uD074\uB9AD\uD574\uC11C\n\uCE74\uB4DC
      \uCC3D \uB744\uC6B0\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 145272856576
    m_Localized: "\uC8FC\uBB38 \uCE74\uB4DC(\uB3D9\uC0AC)\uC640\n\uC18D\uC131 \uCE74\uB4DC(\uBA85\uC0AC)\uAC00
      \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 190177075200
    m_Localized: "\uCE74\uB4DC \uB2F9 \uC0AC\uC6A9\uD558\uB294\n\uB9C8\uB098\uB97C
      \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 224868163584
    m_Localized: "\uCE74\uB4DC\uB97C \uC120\uD0DD\uD558\uC138\uC694\n(Hint: \uC8FC\uBB38
      + \uC18D\uC131)"
    m_Metadata:
      m_Items: []
  - m_Id: 282485317632
    m_Localized: "\uCE74\uB4DC \uC870\uD569\uC774 \uC131\uACF5\uC801\uC774\uBA74\n\uC218\uC815\uAD6C\uC5D0
      \uB9C8\uBC95\uC774 \uBCF4\uC5EC\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 348331696128
    m_Localized: "\uC218\uC815\uAD6C\uB97C \uD074\uB9AD\uD574\uC11C \uB9C8\uBC95\uC744
      \uC870\uD569\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 391205871616
    m_Localized: "\uD65C\uC131\uD654\uB41C \uC704\uCE58\uB97C \uD074\uB9AD\uD558\uC5EC\n\uB9C8\uBC95\uC744
      \uC0AC\uC6A9\uD574\uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 440845459456
    m_Localized: "\uC0C1\uB300\uBC29\uC758 \uCCB4\uB825\uC744 \uAE4E\uC544\uC11C\n\uC2B9\uB9AC\uD574\uBCF4\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 486739533824
    m_Localized: "\uBA54\uC778 \uD654\uBA74\uC5D0\uC11C\n\uB9C8\uBC95\uC11C\uB97C
      \uBCFC \uC218 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 670076755968
    m_Localized: "\uB9C8\uBC95\uC11C \uD654\uBA74\uC5D0\uC11C\n\uAC01 \uB9C8\uBC95\uC758
      \uCE74\uB4DC \uC870\uD569\uC744\n\uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 17619801198428160
    m_Localized: "\uC751"
    m_Metadata:
      m_Items: []
  - m_Id: 17619899324170240
    m_Localized: "\uC544\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 17634470650839040
    m_Localized: "\uD639\uC2DC \uC774 \uAC8C\uC784 \uCC98\uC74C\uD558\uB2C8?\n\uADF8\uB807\uB2E4\uBA74
      \uC5B4\uB5BB\uAC8C \uD558\uB294\uC9C0 \uC54C\uB824\uC904\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22654931925569536
    m_Localized: "\uBA3C\uC800 \uC774 \uC138\uC0C1\uC5D4 \uB9C8\uBC95 \uCE74\uB4DC\uAC00 \uC788\uC5B4~\n\uCE74\uB4DC \uD55C \uC7A5\uC774 \uB9C8\uBC95 \uD558\uB098\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655127950561280
    m_Localized: "\uCE74\uB4DC\uB97C \uACE0\uB974\uBA74 \uBC14\uB85C \uC870\uC900\uC73C\uB85C \uB118\uC5B4\uAC00~\n\uC2DC\uC804\uD560 \uC790\uB9AC\uB97C \uD074\uB9AD\uD558\uBA74 \uB9C8\uBC95\uC774 \uB098\uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655217972908032
    m_Localized: "\uB108\uD55C\uD14C \uC9C0\uAE08 \uD654\uC5FC\uD0C4\uC774 \uC788\uC73C\uB2C8\n\uD55C\uBC88 \uC2DC\uC804\uD574\uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 22655475352178688
    m_Localized: "\uC798\uD588\uC5B4~ \uB108 \uC18C\uC9C8\uC774 \uC788\uAD6C\uB098?!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655588501917696
    m_Localized: "\uB9C8\uBC95\uB9C8\uB2E4 \uC0AC\uAC70\uB9AC\uB3C4 \uBC94\uC704\uB3C4 \uB2EC\uB77C~\n\uD558\uC218\uC778\uC744 \uBD88\uB7EC\uB0B4\uB294 \uB9C8\uBC95\uB3C4 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655689043578880
    m_Localized: "\uC774\uBC88\uC5D4 \uBB3C\uACB0 \uAD81\uC218\uB97C \uC18C\uD658\uD574\uC11C\n\uC804\uC7A5\uC5D0 \uC138\uC6CC\uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 22655833889673216
    m_Localized: "\uC624~ \uB300\uB2E8\uD55C\uB370~? \uC774\uB7F0 \uD558\uC218\uC778\uB4E4\uC744
      \uC18C\uD658\uD574\uC11C \uC804\uC7A5\uC758 \uC6B0\uC704\uB97C \uAC00\uC838\uC624\uB294
      \uAC8C \uC911\uC694\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655909726883840
    m_Localized: "\uCE74\uB4DC\uB9C8\uB2E4 \uC6D0\uC18C\uAC00 \uBD99\uC5B4 \uC788\uC5B4~\n\uC6D0\uC18C\uB07C\uB9AC \uC0C1\uC131\uC774 \uC788\uC73C\uB2C8 \uB9C8\uBC95\uC11C\uC5D0\uC11C \uD655\uC778\uD574\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 22656315026673664
    m_Localized: "\uC774\uC81C \uB9C8\uBC95\uC744 \uC0AC\uC6A9\uD574\uC11C \uC0C1\uB300\uB97C
      \uB9C8\uBB34\uB9AC\uD574\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 22656432915976192
    m_Localized: "\uC624~ \uB10C \uCD5C\uACE0\uC758 \uB9C8\uBC95\uC0AC\uAC00 \uB420
      \uC790\uC9C8\uC774 \uBCF4\uC774\uB294\uAD6C\uB098! \uD6CC\uB96D\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 27802988117622784
    m_Localized: "\uC774\uC81C \uC5EC\uB7EC \uC0AC\uB78C\uB4E4\uACFC \uC804\uD22C\uB97C
      \uD558\uBA74\uC11C \uC2E4\uB825\uC744 \uD0A4\uC6CC\uBD10~~  \uD654\uC774\uD305!!"
    m_Metadata:
      m_Items: []
  - m_Id: 27811470703198208
    m_Localized: "\uC544, \uCC38\uACE0\uB85C \uD558\uB2E8\uC758 \uBC14\uB294 \uB9C8\uB098
      \uBC14\uB97C \uB204\uB974\uBA74 \uC62C\uB77C\uC624\uACE0, \uD544\uB4DC\uB97C
      \uB204\uB974\uBA74 \uB0B4\uB824\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 27897468149555200
    m_Localized: "\uC88B\uC544 \uADF8\uB7FC \uB098\uB97C \uB530\uB77C\uC640!"
    m_Metadata:
      m_Items: []
  - m_Id: 27897500370198528
    m_Localized: "\uADF8\uB798 \uADF8\uB7FC \uC5F4\uC2EC\uD788 \uD574\uBD10~"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
