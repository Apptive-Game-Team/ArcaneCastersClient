  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: tutorial_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d001a424f0bbb49788a1cbb2c7cf88a4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 31254896640
    m_Localized: Skip Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 63110635520
    m_Localized: 'Click the Mana Bar

      to open the card window'
    m_Metadata:
      m_Items: []
  - m_Id: 145272856576
    m_Localized: 'There are Spell Cards (verbs)

      and Attribute Cards (nouns)'
    m_Metadata:
      m_Items: []
  - m_Id: 190177075200
    m_Localized: 'You can check the

      mana cost for each card'
    m_Metadata:
      m_Items: []
  - m_Id: 224868163584
    m_Localized: 'Select cards

      (Hint: Spell + Attribute)'
    m_Metadata:
      m_Items: []
  - m_Id: 282485317632
    m_Localized: 'If the card combination is successful,

      the spell appears
      in the orb'
    m_Metadata:
      m_Items: []
  - m_Id: 348331696128
    m_Localized: Click the orb to combine the magic
    m_Metadata:
      m_Items: []
  - m_Id: 391205871616
    m_Localized: 'Click an activated location

      to cast the spell'
    m_Metadata:
      m_Items: []
  - m_Id: 440845459456
    m_Localized: 'Reduce the opponent''s health

      to achieve victory'
    m_Metadata:
      m_Items: []
  - m_Id: 486739533824
    m_Localized: 'You can view the Magic Book

      on the main screen'
    m_Metadata:
      m_Items: []
  - m_Id: 670076755968
    m_Localized: 'In the Magic Book screen,

      you can check the card combinations

      for
      each spell'
    m_Metadata:
      m_Items: []
  - m_Id: 17619801198428160
    m_Localized: Yay
    m_Metadata:
      m_Items: []
  - m_Id: 17619899324170240
    m_Localized: Nay
    m_Metadata:
      m_Items: []
  - m_Id: 17634470650839040
    m_Localized: 'Is this your first time playing?

      If so, want me to show
      you how it works?'
    m_Metadata:
      m_Items: []
  - m_Id: 22654931925569536
    m_Localized: First of all, this world runs on Magic Cards. One card is one spell!
    m_Metadata:
      m_Items: []
  - m_Id: 22655127950561280
    m_Localized: Pick a card and you go straight to aiming. Click the spot you want and the spell flies!
    m_Metadata:
      m_Items: []
  - m_Id: 22655217972908032
    m_Localized: "You\u2019ve got Fire Shot right now, so why don\u2019t you try casting it?"
    m_Metadata:
      m_Items: []
  - m_Id: 22655475352178688
    m_Localized: "Nice work! You\u2019ve really got a knack for this!"
    m_Metadata:
      m_Items: []
  - m_Id: 22655588501917696
    m_Localized: Every spell has its own range and area. Some of them summon minions for you!
    m_Metadata:
      m_Items: []
  - m_Id: 22655689043578880
    m_Localized: This time, summon an Aqua Archer and put it on the field.
    m_Metadata:
      m_Items: []
  - m_Id: 22655833889673216
    m_Localized: Whoa, nice! Summoning minions like that is key to taking control
      of the battlefield!
    m_Metadata:
      m_Items: []
  - m_Id: 22655909726883840
    m_Localized: Every card carries an element, and elements counter each other. Check the chart in the magic book!
    m_Metadata:
      m_Items: []
  - m_Id: 22656315026673664
    m_Localized: Now, use your spells to finish off your opponent!
    m_Metadata:
      m_Items: []
  - m_Id: 22656432915976192
    m_Localized: "Whoa\u2026 you\u2019ve definitely got what it takes to become a
      top-class mage. Excellent!"
    m_Metadata:
      m_Items: []
  - m_Id: 27802988117622784
    m_Localized: Now go fight against lots of different people and sharpen your skills.
      Good Luck!
    m_Metadata:
      m_Items: []
  - m_Id: 27811470703198208
    m_Localized: 'Just FYI: the bottom bar slides up when you tap the mana bar, and
      slides down when you tap the field.'
    m_Metadata:
      m_Items: []
  - m_Id: 27897468149555200
    m_Localized: Alright, follow me!
    m_Metadata:
      m_Items: []
  - m_Id: 27897500370198528
    m_Localized: Great, give it your best shot!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
