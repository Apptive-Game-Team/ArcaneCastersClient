  m_TableData:
  - m_Id: 31254896640
    m_Localized: Skip Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 63110635520
    m_Localized: Tap the mana bar to open your cards
    m_Metadata:
      m_Items: []
  - m_Id: 190177075200
    m_Localized: Each card shows the mana it costs
    m_Metadata:
      m_Items: []
  - m_Id: 391205871616
    m_Localized: Tap a marked spot to cast the spell
    m_Metadata:
      m_Items: []
  - m_Id: 440845459456
    m_Localized: Bring your opponent down to zero to win
    m_Metadata:
      m_Items: []
  - m_Id: 486739533824
    m_Localized: Open the Magic Book from the lobby
    m_Metadata:
      m_Items: []
  - m_Id: 17619801198428160
    m_Localized: Yes
    m_Metadata:
      m_Items: []
  - m_Id: 17619899324170240
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 17634470650839040
    m_Localized: First time here? Want a quick guide?
    m_Metadata:
      m_Items: []
  - m_Id: 22655127950561280
    m_Localized: Pick a card, then tap a spot to cast it
    m_Metadata:
      m_Items: []
  - m_Id: 22655217972908032
    m_Localized: Pick Fire Shot and place it on the field
    m_Metadata:
      m_Items: []
  - m_Id: 22655475352178688
    m_Localized: Nice work! You have a knack for this
    m_Metadata:
      m_Items: []
  - m_Id: 22655588501917696
    m_Localized: Every spell has its own range and area
    m_Metadata:
      m_Items: []
  - m_Id: 22655689043578880
    m_Localized: Pick Aqua Archer and place it on the field
    m_Metadata:
      m_Items: []
  - m_Id: 22655833889673216
    m_Localized: Great! Minions help you hold the field
    m_Metadata:
      m_Items: []
  - m_Id: 22655909726883840
    m_Localized: Elements counter each other. Check the Magic Book
    m_Metadata:
      m_Items: []
  - m_Id: 22656315026673664
    m_Localized: Finish off your opponent with spells
    m_Metadata:
      m_Items: []
  - m_Id: 22656432915976192
    m_Localized: Excellent! You will make a fine mage
    m_Metadata:
      m_Items: []
  - m_Id: 27802988117622784
    m_Localized: Now test your skills against others. Good luck!
    m_Metadata:
      m_Items: []
  - m_Id: 27811470703198208
    m_Localized: Tap the mana bar to raise your cards, tap the field to lower them
    m_Metadata:
      m_Items: []
  - m_Id: 27897468149555200
    m_Localized: Great, follow me!
    m_Metadata:
      m_Items: []
  - m_Id: 27897500370198528
    m_Localized: Okay, good luck!
    m_Metadata:
      m_Items: []
  references:
