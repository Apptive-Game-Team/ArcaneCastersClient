  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: MagicBook_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: a5fb4d045cc352340a0b295aafdb7db4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1000000
    m_Localized: "\uBB3C \uC2AC\uB77C\uC784 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uB300\uC0C1\uC744 \uBA40\uB9AC\uC11C \uACF5\uACA9\uD558\uBA70 \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uBB3C\uC758 \uC9C0\uB300\uB97C \uB0A8\uAE30\uBA70, \uBB3C \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC740 \uC544\uAD70\uC774\uB77C\uB3C4 \uC774 \uC9C0\uB300\uC5D0 \uB2FF\uC73C\uBA74 \uC816\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000001
    m_Localized: "\uD654\uC5FC\uD0C4\uC744 \uBAA9\uD45C \uBC29\uD5A5\uC73C\uB85C \uC3D8\uC544 \uBCF4\uB0C5\uB2C8\uB2E4. \uCC98\uC74C \uB9DE\uC740 \uC801 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uC5D0\uC11C \uD3ED\uBC1C\uD558\uBA70 \uC8FC\uBCC0\uC758 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0, \uC9C1\uC811 \uB9DE\uC740 \uC801\uC740 \uBD88\uD0C0\uAC8C \uD569\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000002
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uAC04\uD5D0\uCC9C\uC744 \uC19F\uAD6C\uCE58\uAC8C \uD574, \uC7A0\uC2DC \uB4A4 \uBC94\uC704 \uC548\uC758 \uBAA8\uB4E0 \uC720\uB2DB\uACFC \uAC74\uBB3C\uC5D0 \uD53C\uD574\uB97C \uC8FC\uACE0 \uC9C0\uC0C1 \uC720\uB2DB\uC744 \uACF5\uC911\uC73C\uB85C \uB744\uC6C1\uB2C8\uB2E4. \uC544\uAD70\uB3C4 \uD568\uAED8 \uD53C\uD574\uB97C \uC785\uACE0 \uB5A0\uC624\uB974\uBA70, \uBB34\uAC70\uC6B4 \uC720\uB2DB\uC740 \uB35C \uB5A0\uC624\uB985\uB2C8\uB2E4. \uB5A0\uC624\uB978 \uC720\uB2DB\uC740 \uCC29\uC9C0\uD560 \uB54C\uAE4C\uC9C0 \uC9C0\uC0C1 \uACF5\uACA9\uC758 \uB300\uC0C1\uC774 \uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000003
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB9C8\uB3C4 \uB300\uD3EC\uB97C \uC138\uC6CC \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC744 \uD3EC\uACA9\uD569\uB2C8\uB2E4. \uAC74\uBB3C\uACFC \uC801 \uAE30\uC9C0\uB3C4 \uB178\uB9AC\uC9C0\uB9CC \uACF5\uC911 \uC720\uB2DB\uC740 \uB9DE\uD788\uC9C0 \uBABB\uD558\uBA70, \uD30C\uAD34\uB418\uBA74 \uC9C0\uC0C1 \uC720\uB2DB\uC758 \uAE38\uC744 \uB9C9\uB294 \uC794\uD574\uAC00 \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000004
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB300\uACF5 \uB9C8\uB3C4\uD0D1\uC744 \uC138\uC6CC \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACF5\uC911 \uC801\uC744 \uACF5\uACA9\uD558\uACE0, \uADF8 \uC8FC\uBCC0\uC758 \uC801\uC5D0\uAC8C\uB3C4 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC0C1 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000005
    m_Localized: "\uC138\uACC4\uC218\uC758 \uB9C8\uB825\uC774 \uACE0\uC778 \uC0D8\uC744 \uC5F4\uC5B4 \uC11C \uC788\uB294 \uB3D9\uC548 \uB9C8\uB098 \uD68C\uBCF5 \uC18D\uB3C4\uB97C \uB192\uC785\uB2C8\uB2E4. \uC801\uC774 \uD30C\uAD34\uD560 \uC218 \uC788\uC73C\uBA70, \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC800\uC808\uB85C \uB9D0\uB77C \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000006
    m_Localized: "\uC7A5\uBE44\uB97C \uB2E4\uB8E8\uB294 \uBB3C \uC2AC\uB77C\uC784 \uAD81\uC218\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC3D8\uBA70, \uC9C0\uC0C1 \uC720\uB2DB\uACFC \uACF5\uC911 \uC720\uB2DB, \uAC74\uBB3C, \uC801 \uAE30\uC9C0\uB97C \uBAA8\uB450 \uACF5\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000007
    m_Localized: "\uC774\uB07C \uB080 \uB3CC \uACE8\uB818 \uC804\uC0AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \uADFC\uC811 \uACF5\uACA9\uD558\uBA70 \uB9DE\uC740 \uC801\uC744 \uC870\uAE08 \uBC00\uC5B4\uB0C5\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD558\uACE0, \uC4F0\uB7EC\uC9C0\uBA74 \uC9C0\uC0C1 \uC720\uB2DB\uC758 \uAE38\uC744 \uB9C9\uB294 \uC794\uD574\uAC00 \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000008
    m_Localized: "\uC138\uACC4\uC218\uC758 \uBC14\uB78C \uC815\uB839 \uAE30\uC218\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uBE60\uB974\uAC8C \uB2EC\uB824 \uC801 \uAE30\uC9C0\uB97C \uACE7\uC7A5 \uADFC\uC811 \uACF5\uACA9\uD558\uBA70, \uAE30\uC9C0\uB97C \uB178\uB9B4 \uC218 \uC5C6\uC744 \uB54C\uB9CC \uB2E4\uB978 \uC9C0\uC0C1 \uC801\uACFC \uC2F8\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000009
    m_Localized: "\uC138\uACC4\uC218\uC5D0\uC11C \uD0DC\uC5B4\uB09C \uC804\uAE30 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uACF5\uC911\uC744 \uB0A0\uBA70 \uC9C0\uC0C1 \uC720\uB2DB\uACFC \uAC74\uBB3C, \uC801 \uAE30\uC9C0\uB97C \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uACF5\uACA9\uD558\uC9C0\uB9CC \uB2E4\uB978 \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000010
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uD558\uAE09 \uC545\uB9C8\uB4E4\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \uD654\uC5FC\uC744 \uBFDC\uC5B4 \uB9DE\uC740 \uB300\uC0C1\uC744 \uBD88\uD0DC\uC6B0\uBA70, \uC8FC\uBCC0\uC758 \uBD88 \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC740 \uC544\uAD70\uC774\uB77C\uB3C4 \uBD88\uD0DC\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000011
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC758 \uC881\uC740 \uAD6C\uC5ED\uC5D0 \uC989\uC2DC \uB099\uB8B0\uB97C \uB0B4\uB9AC\uAF42\uACE0, \uC9E7\uC740 \uAC04\uACA9\uC73C\uB85C \uB450 \uBC88 \uB354 \uB0B4\uB9AC\uCE69\uB2C8\uB2E4. \uAD6C\uC5ED \uC548\uC758 \uC9C0\uC0C1\uACFC \uACF5\uC911 \uC801\uC744 \uBAA8\uB450 \uACF5\uACA9\uD558\uBA70, \uAD6C\uC5ED \uC548\uC758 \uC544\uAD70 \uBC88\uAC1C \uC720\uB2DB\uC740 \uD53C\uD574 \uB300\uC2E0 \uCDA9\uC804\uB429\uB2C8\uB2E4. \uB099\uB8B0\uAC00 \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uC5D0\uB294 \uC7A0\uC2DC \uC804\uAE30\uC7A5\uC774 \uB0A8\uC544 \uBC88\uAC1C \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC774 \uB4E4\uC5B4\uC624\uBA74 \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000012
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uC6A9\uC554 \uAC11\uAC01 \uC545\uB9C8\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \uADF8 \uC790\uB9AC\uC5D0 \uD654\uC5FC \uC77C\uACA9\uC744 \uB0B4\uB9AC\uCCD0 \uC8FC\uBCC0\uC758 \uC801 \uBAA8\uB450\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uBD88\uD0DC\uC6C1\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD558\uACE0, \uC8FC\uBCC0\uC758 \uBD88 \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC740 \uC544\uAD70\uC774\uB77C\uB3C4 \uBD88\uD0DC\uC6B0\uBA70, \uC4F0\uB7EC\uC9C0\uBA74 \uC794\uD574\uAC00 \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000013
    m_Localized: "\uCE58\uC720 \uD1A0\uD15C\uC744 \uC138\uC6CC \uBC94\uC704 \uC548\uC758 \uC544\uAD70 \uC720\uB2DB\uACFC \uAC74\uBB3C, \uAE30\uC9C0\uB97C \uC77C\uC815 \uAC04\uACA9\uC73C\uB85C \uD68C\uBCF5\uC2DC\uD0A4\uBA70 \uACF5\uC911 \uC720\uB2DB\uB3C4 \uD3EC\uD568\uD569\uB2C8\uB2E4. \uC544\uAD70 \uC720\uB2DB \uC704\uC5D0 \uB193\uC73C\uBA74 \uADF8 \uC720\uB2DB\uC744 \uB530\uB77C\uB2E4\uB2C8\uACE0, \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000014
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uBAA8\uB798 \uD3ED\uD48D\uC744 \uC77C\uC73C\uCF1C \uD55C\uB3D9\uC548 \uBA38\uBB34\uB974\uAC8C \uD558\uBA70, \uADF8 \uC548\uC5D0 \uC120 \uC801\uC5D0\uAC8C \uACC4\uC18D \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC0C1 \uC801\uC5D0\uAC8C\uB9CC \uB2FF\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000015
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0\uC11C \uC804\uC7A5 \uC911\uC559\uC744 \uD5A5\uD574 \uCC9C\uCC9C\uD788 \uC6C0\uC9C1\uC774\uB294 \uD68C\uC624\uB9AC\uB97C \uC77C\uC73C\uD0B5\uB2C8\uB2E4. \uB2FF\uC740 \uC9C0\uC0C1 \uC801\uC744 \uBD99\uC7A1\uC544 \uBE59\uAE00\uBE59\uAE00 \uB3CC\uB9AC\uBA70 \uACF5\uC911\uC73C\uB85C \uB744\uC6B0\uACE0, \uB9CE\uC774 \uBD99\uC7A1\uC744\uC218\uB85D \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000016
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810 \uC8FC\uBCC0\uC758 \uBB34\uC791\uC704 \uC704\uCE58\uC5D0 \uBA87 \uCD08 \uB3D9\uC548 \uC720\uC131\uC744 \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4. \uC720\uC131\uC740 \uD558\uB298\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uBA70 \uCC98\uC74C \uB2FF\uC740 \uC9C0\uC0C1 \uB610\uB294 \uACF5\uC911\uC758 \uC801 \uD558\uB098\uC5D0\uAC8C\uB9CC \uD53C\uD574\uB97C \uC8FC\uACE0, \uC544\uBB34\uAC83\uB3C4 \uB2FF\uC9C0 \uC54A\uC73C\uBA74 \uADF8\uB0E5 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000017
    m_Localized: "\uAD6C\uB984\uBE44\uB298\uC758 \uBC14\uB78C \uC815\uB839 \uC6B4\uB8E1\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uACF5\uC911\uC744 \uB0A0\uBA70 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1\uACFC \uACF5\uC911\uC758 \uC801\uC744 \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uACF5\uACA9\uD558\uACE0, \uC8FC\uBCC0 \uC720\uB2DB\uC744 \uBAA8\uB450 \uC801\uC154 \uBD88\uC744 \uAEBC \uC90D\uB2C8\uB2E4. \uAC00\uB054 \uC5F0\uC1C4 \uBC88\uAC1C\uB97C \uB0A0\uB824 \uCC98\uC74C \uB9DE\uC740 \uC801\uC744 \uAE30\uC808\uC2DC\uD0A8 \uB4A4 \uC810\uC810 \uC57D\uD574\uC9C0\uB294 \uD53C\uD574\uB85C \uB2E4\uB978 \uC801\uC5D0\uAC8C \uD280\uC5B4 \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000018
    m_Localized: "\uCC9C\uB465\uC0C8 \uD3B8\uB300\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uACF5\uC911\uC744 \uB0A0\uB2E4\uAC00 \uC9C0\uC0C1 \uC801\uACFC \uAC74\uBB3C, \uC801 \uAE30\uC9C0\uB97C \uD5A5\uD574 \uAE09\uAC15\uD558\uD558\uBA70, \uB9CE\uC774 \uB0B4\uB824\uC62C\uC218\uB85D \uB354 \uAC15\uD558\uAC8C \uD0C0\uACA9\uD55C \uB4A4 \uB2E4\uC2DC \uB0A0\uC544\uC624\uB985\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000019
    m_Localized: "\uACE0\uBAA9 \uC218\uD638\uC790\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uB290\uB9AC\uC9C0\uB9CC \uB2E8\uB2E8\uD558\uAC8C \uC9C0\uC0C1 \uC801\uC744 \uADFC\uC811 \uACF5\uACA9\uD558\uACE0 \uC2A4\uC2A4\uB85C \uCC9C\uCC9C\uD788 \uD68C\uBCF5\uD569\uB2C8\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uC78E\uC0AC\uADC0 \uAE38\uC774 \uB0A8\uC544 \uADF8 \uC704\uC5D0 \uC120 \uC720\uB2DB\uC744 \uC544\uAD70\uACFC \uC801 \uAD6C\uBD84 \uC5C6\uC774 \uD68C\uBCF5\uC2DC\uD0A4\uACE0, \uC790\uC5F0 \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC758 \uC6C0\uC9C1\uC784\uC740 \uB290\uB824\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000020
    m_Localized: "\uB369\uAD74\uB85C \uBAB8\uC744 \uC5EE\uC740 \uD480 \uC815\uB839\uB4E4\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1\uACFC \uACF5\uC911\uC758 \uC801\uC744 \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uACF5\uACA9\uD558\uBA70, \uB9DE\uC740 \uC801\uC740 \uC18D\uBC15\uB418\uC5B4 \uB290\uB824\uC9C0\uACE0 \uACF5\uC911 \uC720\uB2DB\uC740 \uB545\uC73C\uB85C \uB04C\uB824 \uB0B4\uB824\uC635\uB2C8\uB2E4. \uC18D\uBC15\uB41C \uC801\uC774 \uBD88 \uC18D\uC131 \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uC18D\uBC15\uC774 \uD480\uB9AC\uBA70 \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uACE0, \uC790\uC5F0 \uC18D\uC131 \uC801\uC5D0\uAC8C\uB294 \uD1B5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000021
    m_Localized: "\uB369\uAD74 \uAD70\uB77D\uC744 \uC2EC\uC5B4 \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC758 \uBC1C\uBC11\uC5D0 \uBA87 \uCD08\uB9C8\uB2E4 \uB369\uAD74\uC744 \uC19F\uAD6C\uCE58\uAC8C \uD558\uACE0, \uB369\uAD74\uC5D0 \uB2FF\uC740 \uC801\uC740 \uD53C\uD574\uB97C \uC785\uACE0 \uB290\uB824\uC9D1\uB2C8\uB2E4. \uAD70\uB77D\uC740 \uACF5\uACA9\uBC1B\uC544 \uD30C\uAD34\uB418\uAC70\uB098 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9C0\uBA70, \uACF5\uC911 \uC720\uB2DB\uC740 \uB178\uB9AC\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000022
    m_Localized: "\uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uB8EC\uBC14\uC704 \uC8FC\uC220\uC0AC\uB97C \uBD88\uB7EC \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uAC78\uC5B4\uAC00 \uD55C \uBC88\uC5D0 \uBC14\uC704 \uB450 \uAC1C\uB97C \uB358\uC9D1\uB2C8\uB2E4. \uC0AC\uAC70\uB9AC \uC548\uC758 \uAC00\uAE4C\uC6B4 \uC801 \uB458\uC5D0\uAC8C \uD558\uB098\uC529 \uB0A0\uB9AC\uACE0, \uC801\uC774 \uD558\uB098\uBFD0\uC774\uBA74 \uADF8 \uC801\uC5D0\uAC8C \uB458 \uB2E4 \uB0A0\uB9AC\uBA70, \uC9C0\uC0C1\uACFC \uACF5\uC911 \uC720\uB2DB\uC744 \uBAA8\uB450 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000023
    m_Localized: "\uC138\uACC4\uC218\uC5D0\uC11C \uB5A8\uC5B4\uC9C4 \uC791\uC740 \uC528\uC557 \uC815\uB839 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000024
    m_Localized: "\uC791\uC740 \uC7BF\uBD88 \uC545\uB9C8 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uB300\uC0C1\uC5D0\uAC8C \uAC78\uC5B4\uAC00 \uADFC\uC811 \uACF5\uACA9\uD558\uBA70 \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uBD88\uD0C0\uB294 \uC9C0\uB300\uB97C \uB0A8\uAE30\uBA70, \uBD88 \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC740 \uC544\uAD70\uC774\uB77C\uB3C4 \uC774 \uC9C0\uB300\uC5D0 \uB2FF\uC73C\uBA74 \uBD88\uD0D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000025
    m_Localized: "\uC791\uC740 \uB3CC \uACE8\uB818\uB4E4\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uB300\uC0C1\uC5D0\uAC8C \uB290\uB9AC\uAC8C \uAC78\uC5B4\uAC00 \uADFC\uC811 \uACF5\uACA9\uD569\uB2C8\uB2E4. \uD2BC\uD2BC\uD558\uC9C0\uB9CC \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000026
    m_Localized: "\uACF5\uC911\uC5D0 \uB5A0 \uC788\uB294 \uBC14\uB78C \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uC801 \uACF5\uC911 \uC720\uB2DB\uC774 \uB098\uD0C0\uB0A0 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4\uAC00 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACF5\uC911 \uC720\uB2DB\uC5D0\uAC8C \uB2EC\uB824\uB4E4\uC5B4 \uD3ED\uBC1C\uD558\uBA70, \uC8FC\uBCC0\uC758 \uC801 \uACF5\uC911 \uC720\uB2DB\uC5D0\uAC8C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC4F0\uB7EC\uC9C8 \uB54C\uB3C4 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uD3ED\uBC1C\uD558\uBA70 \uC9C0\uC0C1 \uC720\uB2DB\uACFC \uAC74\uBB3C\uC740 \uACF5\uACA9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000027
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uC6A9\uC554 \uADE0\uC5F4\uC744 \uC5F4\uC5B4, \uC7A0\uC2DC \uB4A4 \uBC94\uC704 \uC548\uC758 \uBAA8\uB4E0 \uC720\uB2DB\uACFC \uAC74\uBB3C\uC5D0 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC544\uAD70\uB3C4 \uD53C\uD574\uB97C \uC785\uC73C\uBA70, \uC801\uC740 \uBD88\uD0C0\uC624\uB985\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000028
    m_Localized: "\uC21C\uD48D \uD1A0\uD15C\uC744 \uC138\uC6CC, \uC55E\uCABD \uBC94\uC704 \uC548\uC758 \uC801 \uC9C0\uC0C1 \uC720\uB2DB\uC744 \uC801 \uAE30\uC9C0 \uBC29\uD5A5\uC73C\uB85C \uACC4\uC18D \uBC00\uC5B4\uB0C5\uB2C8\uB2E4. \uD53C\uD574\uB294 \uC8FC\uC9C0 \uC54A\uC73C\uBA70 \uBB34\uAC70\uC6B4 \uC720\uB2DB\uC740 \uB35C \uBC00\uB824\uB0A9\uB2C8\uB2E4. \uC7A0\uC2DC \uD6C4 \uC0AC\uB77C\uC9C0\uACE0 \uC801\uC774 \uBA3C\uC800 \uBD80\uC220 \uC218\uB3C4 \uC788\uC73C\uBA70, \uACF5\uC911 \uC720\uB2DB\uC740 \uBC00\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000029
    m_Localized: "\uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294 \uC791\uC740 \uD22C\uC11D \uD3EC\uD0D1\uC744 \uC138\uC6CC, \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uC5D0 \uBC14\uC704\uB97C \uC3D8\uC544 \uBCF4\uB0C5\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uC7A0\uC2DC \uD6C4 \uBB34\uB108\uC9C0\uBA70, \uC801\uC774 \uBA3C\uC800 \uBD80\uC220 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000030
    m_Localized: "\uC138\uACC4\uC218\uC758 \uBB18\uBAA9\uC744 \uC2EC\uC5B4 \uAC00\uAE4C\uC774 \uC788\uB294 \uC544\uAD70 \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uB97C \uC77C\uC815\uD55C \uAC04\uACA9\uC73C\uB85C \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4. \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC2DC\uB4E4\uBA70, \uC801\uC774 \uBA3C\uC800 \uD30C\uAD34\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000031
    m_Localized: "\uBC14\uB78C \uCE7C\uB0A0\uC744 \uB0A0\uB824 \uACBD\uB85C\uC0C1\uC758 \uC801 \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uB97C \uBAA8\uB450 \uAFF0\uB6AB\uC2B5\uB2C8\uB2E4. \uD558\uB098\uB97C \uC9C0\uB0A0 \uB54C\uB9C8\uB2E4 \uD53C\uD574\uAC00 \uC904\uC5B4\uB4E4\uBA70, \uD544\uB4DC\uB97C \uBC97\uC5B4\uB0A0 \uB54C\uAE4C\uC9C0 \uB0A0\uC544\uAC11\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000032
    m_Localized: "\uC138\uACC4\uC218\uC758 \uB369\uAD74\uC744 \uC2DC\uC804\uC790\uBD80\uD130 \uBAA9\uD45C \uBC29\uD5A5\uC73C\uB85C \uC77C\uB82C\uB85C \uC5F0\uB2EC\uC544 \uC19F\uAD6C\uCE58\uAC8C \uD574, \uAE38 \uC704\uC758 \uC801 \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uB97C \uD55C \uBC88\uC529 \uD0C0\uACA9\uD558\uACE0 \uC18D\uBC15\uD574 \uB290\uB9AC\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4. \uC720\uB2DB\uC5D0 \uB9C9\uD788\uC9C0 \uC54A\uC73C\uBA70 \uACF5\uC911 \uC720\uB2DB\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uACE0, \uC18D\uBC15\uB41C \uB300\uC0C1\uC774 \uBD88 \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uC18D\uBC15\uC774 \uD480\uB9AC\uBA74\uC11C \uCD94\uAC00 \uD53C\uD574\uB97C \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000033
    m_Localized: "\uBB3C\uC758 \uD574\uC77C\uC744 \uBD88\uB7EC \uB098\uC544\uAC00\uB294 \uBC29\uD5A5\uC73C\uB85C \uB2FF\uB294 \uC801 \uC9C0\uC0C1 \uC720\uB2DB\uC744 \uBAA8\uB450 \uBC00\uC5B4\uB0C5\uB2C8\uB2E4. \uAC01 \uC801\uC5D0\uAC8C \uD55C \uBC88 \uC57D\uD55C \uD53C\uD574\uB9CC \uC90D\uB2C8\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uBB3C\uC758 \uC9C0\uB300\uB97C \uB0A8\uAE30\uBA70, \uBB3C \uC18D\uC131\uC774 \uC544\uB2CC \uC720\uB2DB\uC740 \uC544\uAD70\uC774\uB77C\uB3C4 \uC816\uC2B5\uB2C8\uB2E4. \uD574\uC77C\uC740 \uC7A0\uC2DC \uD6C4 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000034
    m_Localized: "\uBB34\uAC70\uC6B4 \uAC70\uC11D\uC744 \uB545 \uC704\uB85C \uAD74\uB824 \uB2FF\uB294 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uBA70, \uC801\uACFC \uD544\uB4DC\uC758 \uBCBD\uC5D0 \uBD80\uB52A\uD788\uBA74 \uD295\uACA8 \uB098\uAC11\uB2C8\uB2E4. \uBA87 \uBC88 \uD295\uAE30\uACE0 \uB098\uBA74 \uC0AC\uB77C\uC9C0\uBA70 \uACF5\uC911 \uC720\uB2DB\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000035
    m_Localized: "\uB1CC\uAD11\uC744 \uB0A0\uB824 \uCC98\uC74C \uB2FF\uC740 \uC801\uC744 \uD0C0\uACA9\uD558\uACE0 \uC7A0\uC2DC \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4. \uC774\uD6C4 \uADFC\uCC98\uC5D0\uC11C \uC544\uC9C1 \uB9DE\uC9C0 \uC54A\uC740 \uC801\uC5D0\uAC8C \uD295\uACA8 \uAC00\uBA70, \uD295\uAE38 \uB54C\uB9C8\uB2E4 \uD53C\uD574\uAC00 \uC904\uACE0 \uB9DE\uB294 \uC801\uC758 \uC218\uC5D0\uB3C4 \uD55C\uACC4\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uCCAB \uD0C0\uACA9\uC740 \uB0A0\uC544\uAC00\uB294 \uAE38\uC5D0 \uCC98\uC74C \uB2FF\uC740 \uB300\uC0C1\uC774 \uBC1B\uC73C\uBA70, \uC774\uD6C4 \uD295\uAE40\uC740 \uADFC\uCC98 \uACF5\uC911 \uC720\uB2DB\uC5D0\uAC8C\uB3C4 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000036
    m_Localized: "\uBE44\uB97C \uBFCC\uB9AC\uB294 \uAD6C\uB984\uC744 \uBD88\uB7EC \uC804\uC7A5\uC744 \uC801\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000037
    m_Localized: "\uB3C4\uAE68\uBE44\uBD88\uC744 \uB545 \uC704\uB85C \uB0A0\uB824 \uCC98\uC74C \uB2FF\uC740 \uC801 \uC720\uB2DB\uC758 \uD1B5\uC81C\uAD8C\uC744 \uBE7C\uC557\uC73C\uBA70, \uBE7C\uC557\uAE34 \uC720\uB2DB\uC740 \uC774\uD6C4 \uACC4\uC18D \uC544\uAD70\uC73C\uB85C \uC2F8\uC6C1\uB2C8\uB2E4. \uAE30\uC9C0\uC640 \uC77C\uBD80 \uAC74\uBB3C\uC740 \uBE7C\uC557\uC744 \uC218 \uC5C6\uC73C\uBA70, \uB3C4\uAE68\uBE44\uBD88\uC740 \uADF8\uAC83\uB4E4\uC744 \uC9C0\uB098\uCCD0 \uACC4\uC18D \uB0A0\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000038
    m_Localized: "\uAD11\uB780 \uD1A0\uD15C\uC744 \uB5A8\uC5B4\uB728\uB824 \uCC29\uC9C0\uD55C \uC9C0\uC810 \uC8FC\uBCC0\uC758 \uC720\uB2DB\uC744 \uC7A0\uC2DC \uAD11\uB780 \uC0C1\uD0DC\uB85C \uB9CC\uB4ED\uB2C8\uB2E4. \uAD11\uB780 \uC0C1\uD0DC\uC758 \uC720\uB2DB\uC740 \uD3B8\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uACE0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC720\uB2DB\uC744 \uACF5\uACA9\uD558\uBA70 \uB354 \uBE60\uB974\uAC8C \uACF5\uACA9\uD569\uB2C8\uB2E4. \uC801\uBFD0 \uC544\uB2C8\uB77C \uC544\uAD70 \uC720\uB2DB\uB3C4 \uC601\uD5A5\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000039
    m_Localized: "\uC78E\uBC14\uB78C \uC694\uC815\uC744 \uB5A8\uC5B4\uB728\uB824 \uCC98\uC74C \uB2FF\uC740 \uC544\uAD70 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uB97C \uD68C\uBCF5\uC2DC\uD0A4\uACE0, \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9C0\uB294 \uC544\uAD70 \uAC74\uBB3C\uC758 \uC9C0\uC18D \uC2DC\uAC04\uC744 \uCC98\uC74C\uC73C\uB85C \uB418\uB3CC\uB9BD\uB2C8\uB2E4. \uC801\uC5D0\uAC8C \uBA3C\uC800 \uB2FF\uC73C\uBA74 \uADF8 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uC18D\uBC15\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000040
    m_Localized: "\uD558\uB298\uC5D0\uC11C \uAC70\uC11D\uC744 \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4. \uB5A8\uC5B4\uC9C0\uB294 \uB370 \uC7A0\uC2DC \uAC78\uB9AC\uBA70, \uB5A8\uC5B4\uC9C0\uB2E4 \uCC98\uC74C \uB2FF\uC740 \uC801 \uD558\uB098\uC5D0\uAC8C\uB9CC \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC0C1\uACFC \uACF5\uC911 \uC720\uB2DB \uBAA8\uB450 \uB9DE\uC744 \uC218 \uC788\uACE0, \uBC94\uC704 \uD53C\uD574\uB294 \uC5C6\uC73C\uBA70 \uC544\uB798\uC5D0 \uC801\uC774 \uC5C6\uC73C\uBA74 \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000041
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uACF5\uC218 \uD2B9\uACF5\uB300\uB97C \uB099\uD558\uC0B0\uC73C\uB85C \uBAA9\uD45C \uC9C0\uC810\uC5D0 \uD22C\uC785\uD569\uB2C8\uB2E4. \uCC29\uC9C0\uD558\uAE30 \uC804\uC5D0\uB294 \uC6C0\uC9C1\uC774\uAC70\uB098 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD558\uACE0, \uCC29\uC9C0\uD55C \uB4A4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uAC78\uC5B4\uAC00 \uADFC\uC811 \uACF5\uACA9\uD569\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uC740 \uACF5\uACA9\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000042
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0\uC11C \uC7A0\uC2DC \uB4A4 \uBFCC\uB9AC\uB97C \uC19F\uAD6C\uCE58\uAC8C \uD574 \uBC94\uC704 \uC548\uC758 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uB290\uB9AC\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4. \uBC94\uC704 \uC548\uC5D0 \uC544\uAD70 \uC528\uC557 \uC815\uB839\uC774 \uC788\uC73C\uBA74 \uACE0\uBAA9 \uC218\uD638\uC790\uB85C \uC790\uB77C\uB098\uACE0, \uC5C6\uC73C\uBA74 \uADF8 \uC790\uB9AC\uC5D0 \uC528\uC557 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000043
    m_Localized: "\uC7BF\uBD88 \uBD84\uD654\uAD6C\uB97C \uB0A8\uACA8 \uC0AC\uBC29 \uBB34\uC791\uC704 \uBC29\uD5A5\uC73C\uB85C \uBD88\uB369\uC774\uB97C \uACC4\uC18D \uBFDC\uC5B4\uB0C5\uB2C8\uB2E4. \uBD88\uB369\uC774\uB294 \uCC98\uC74C \uB2FF\uC740 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0, \uC544\uBB34\uB3C4 \uB9DE\uD788\uC9C0 \uBABB\uD558\uBA74 \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uC5D0 \uBD88\uAE38\uC744 \uB0A8\uACA8 \uADF8 \uC704\uC5D0 \uC120 \uC720\uB2DB\uC744 \uC544\uAD70\uAE4C\uC9C0 \uD0DC\uC6C1\uB2C8\uB2E4. \uBD84\uD654\uAD6C\uB294 \uACF5\uACA9\uBC1B\uC544 \uD30C\uAD34\uB418\uAC70\uB098 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000044
    m_Localized: "\uC804\uAE30 \uC815\uB839 \uC950 \uBA87 \uB9C8\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uC950\uB4E4\uC740 \uC801 \uC720\uB2DB\uC740 \uBB34\uC2DC\uD558\uACE0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uAC74\uBB3C\uB85C \uB2EC\uB824\uAC00 \uADFC\uC811 \uACF5\uACA9\uD558\uBA70, \uAC74\uBB3C\uC774 \uC5C6\uC73C\uBA74 \uC801 \uAE30\uC9C0\uB97C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000045
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uC2E0\uD638\uD0D1\uC744 \uB5A8\uC5B4\uB728\uB824 \uC77C\uC815 \uC2DC\uAC04 \uC138\uC6CC \uB461\uB2C8\uB2E4. \uC2E0\uD638\uD0D1\uC740 \uC801\uC774 \uACF5\uACA9\uD560 \uC218 \uC5C6\uACE0, \uB113\uC740 \uBC94\uC704\uC758 \uC544\uAD70 \uC720\uB2DB\uC774 \uC804\uC9C4\uC744 \uBA48\uCD94\uACE0 \uC8FC\uBCC0\uC5D0 \uBAA8\uC5EC \uAC00\uAE4C\uC774 \uC624\uB294 \uC801\uB9CC \uC0C1\uB300\uD558\uBA70, \uC2E0\uD638\uD0D1 \uADFC\uCC98\uC5D0 \uC788\uB294 \uB3D9\uC548 \uACF5\uACA9 \uC18D\uB3C4\uAC00 \uBE68\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000046
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uC7A0\uC2DC \uB4A4 \uC804\uAE30 \uC815\uB839\uC758 \uB1CC\uAD11\uC744 \uD130\uB728\uB824 \uBC94\uC704 \uC548\uC758 \uC801\uC744 \uAC10\uC804\uC2DC\uCF1C \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4. \uBC94\uC704 \uC548\uC758 \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0 \uBAA8\uB450\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uBA70 \uC544\uAD70\uB3C4 \uC608\uC678\uAC00 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000047
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0 \uCE7C\uBC14\uB78C \uD68C\uC624\uB9AC\uB97C \uC77C\uC73C\uCF1C \uBA87 \uCD08 \uB3D9\uC548 \uBC94\uC704 \uC548\uC758 \uBAA8\uB4E0 \uC720\uB2DB\uACFC \uAC74\uBB3C\uC744 \uC8FC\uAE30\uC801\uC73C\uB85C \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4. \uC544\uAD70\uB3C4 \uD53C\uD574\uB97C \uC785\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000048
    m_Localized: "\uAC70\uD488 \uBC30\uC591\uAE30\uB97C \uC124\uCE58\uD574 \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC544\uAD70\uC744 \uAC70\uD488\uC73C\uB85C \uAC10\uC309\uB2C8\uB2E4. \uAC70\uD488\uC740 \uBC1B\uC740 \uACF5\uACA9 \uD55C \uBC88\uC744 \uC644\uC804\uD788 \uB9C9\uACE0 \uD130\uC9C0\uBA70, \uC774\uBBF8 \uAC70\uD488\uC774 \uC788\uB294 \uC544\uAD70\uC740 \uAC74\uB108\uB701\uB2C8\uB2E4. \uBC30\uC591\uAE30\uB294 \uACF5\uACA9\uD558\uC9C0 \uC54A\uACE0 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000049
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB1CC\uC804 \uB9C8\uB3C4\uD0D1\uC744 \uC138\uC6CC \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744 \uACF5\uC911\uACFC \uC9C0\uC0C1 \uAD6C\uBD84 \uC5C6\uC774 \uC804\uAE30\uB85C \uACF5\uACA9\uD558\uACE0, \uADFC\uCC98\uC758 \uB2E4\uB978 \uC801 \uBA87\uC5D0\uAC8C \uB354 \uC57D\uD55C \uD53C\uD574\uB85C \uD295\uACA8 \uAC11\uB2C8\uB2E4. \uB9C8\uB3C4\uD0D1\uC740 \uACF5\uACA9\uBC1B\uC544 \uD30C\uAD34\uB418\uAC70\uB098 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864653363056640
    m_Localized: "\uCC28\uC6D0 \uC720\uB791\uC885 \uACBD\uACC4 \uC6B4\uBC18\uC790\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uC9C1\uC811 \uACF5\uACA9\uD558\uC9C0 \uC54A\uACE0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uAC74\uBB3C\uC774\uB098 \uAE30\uC9C0 \uCABD\uC73C\uB85C \uAC78\uC5B4\uAC00 \uAC70\uB9AC\uB97C \uB454 \uCC44 \uBA48\uCD94\uBA70, \uAC00\uAE4C\uC774 \uC624\uB294 \uC801 \uC9C0\uC0C1 \uC720\uB2DB\uC5D0\uAC8C\uC11C\uB294 \uB2EC\uC544\uB0A9\uB2C8\uB2E4. \uC18C\uD658\uD558\uC790\uB9C8\uC790, \uADF8 \uB4A4\uB85C \uBA87 \uCD08\uB9C8\uB2E4 \uBD88 \uC62C\uCC59\uC774\uC640 \uBC88\uAC1C \uC62C\uCC59\uC774\uB97C \uBC88\uAC08\uC544 \uB0B4\uBCF4\uB0B4\uACE0, \uC62C\uCC59\uC774\uB294 \uC7A0\uC2DC \uB4A4 \uC0AC\uB77C\uC9C0\uB294 \uC9C0\uC0C1 \uADFC\uC811 \uC720\uB2DB\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864718152470528
    m_Localized: "\uD558\uB298\uC744 \uB098\uB294 \uC9C0\uC625\uBD88 \uAD70\uB2E8\uC7A5\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uAD70\uB2E8\uC7A5\uC740 \uC9C1\uC811 \uACF5\uACA9\uD558\uC9C0 \uC54A\uACE0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uCABD\uC73C\uB85C \uB2E4\uAC00\uAC00 \uC77C\uC815 \uAC70\uB9AC\uC5D0\uC11C \uBA48\uCD94\uBA70, \uBA87 \uCD08\uB9C8\uB2E4 \uD558\uAE09 \uC545\uB9C8\uB97C \uB0A0\uB824 \uBCF4\uB0C5\uB2C8\uB2E4. \uD558\uAE09 \uC545\uB9C8\uB294 \uC9C0\uC0C1\uACFC \uACF5\uC911 \uC720\uB2DB\uC744 \uC6D0\uAC70\uB9AC\uB85C \uACF5\uACA9\uD558\uBA70, \uAD70\uB2E8\uC7A5 \uD558\uB098\uAC00 \uB0B4\uBCF4\uB0BC \uC218 \uC788\uB294 \uC218\uC5D0\uB294 \uD55C\uB3C4\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864733830778880
    m_Localized: "\uD558\uB298\uC744 \uB098\uB294 \uBB3C \uC2AC\uB77C\uC784\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uACF5\uC911 \uC720\uB2DB\uB9CC \uB178\uB824 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACF5\uC911 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00 \uD130\uC9C0\uB294 \uAC70\uD488\uC744 \uC3D8\uBA70, \uAC70\uD488\uC740 \uBAA9\uD45C \uADFC\uCC98\uC758 \uB2E4\uB978 \uACF5\uC911 \uC801\uC5D0\uAC8C\uB3C4 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC9C0\uC0C1 \uC720\uB2DB, \uAC74\uBB3C, \uAE30\uC9C0\uB294 \uACF5\uACA9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864741510549504
    m_Localized: "\uBAA9\uD45C \uC9C0\uC810\uC5D0\uC11C \uB1CC\uAD11\uC744 \uACFC\uBD80\uD558\uC2DC\uCF1C \uC7A0\uC2DC \uB4A4 \uBC94\uC704 \uC548\uC758 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uAC10\uC804\uC2DC\uD0B5\uB2C8\uB2E4. \uC870\uAE08 \uB354 \uC9C0\uB098\uBA74 \uAC10\uC804\uB41C \uC801\uC774 \uAC01\uAC01 \uD3ED\uBC1C\uD574 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uB354 \uC57D\uD55C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4. \uC544\uAD70\uC740 \uD53C\uD574\uB97C \uC785\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507520
    m_Localized: "\uB4F1\uC5D0 \uC778\uAC04\uC774 \uB9CC\uB4E0 \uB300\uACF5 \uD3EC\uD0D1\uC744 \uBB36\uC740 \uAF2C\uB9C8\uB3CC\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uB290\uB9AC\uAC8C \uAC78\uC5B4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uB2E4\uAC00\uAC00\uBA70, \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uACF5\uC911 \uC720\uB2DB\uC774 \uC788\uC73C\uBA74 \uBA3C\uC800 \uB178\uB824 \uBA40\uB9AC\uC11C \uC3D8\uACE0 \uADF8 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C\uB3C4 \uD53C\uD574\uAC00 \uD37C\uC9D1\uB2C8\uB2E4. \uC9C0\uC0C1 \uC801\uC740 \uBC14\uC9DD \uBD99\uC5B4\uC11C\uB9CC \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507521
    m_Localized: "\uC815\uB82C"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507522
    m_Localized: "\uC18D\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507523
    m_Localized: "\uD0C0\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507524
    m_Localized: "\uC804\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507525
    m_Localized: "\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507526
    m_Localized: "\uC18D\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507527
    m_Localized: "\uCE74\uB4DC \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507528
    m_Localized: "\uBA40\uB9AC\uC11C \uC801\uC744 \uB54C\uB9AC\uB294 \uB290\uB9B0
      \uC9C0\uC0C1 \uAC70\uC778\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uAC00\uBCBC\uC6B4
      \uC801\uC774 \uC0AC\uAC70\uB9AC\uC5D0 \uB4E4\uC5B4\uC624\uBA74 \uB04C\uC5B4\uB2F9\uACA8
      \uAE30\uC808\uC2DC\uD0A8 \uB4A4 \uBD88\uC8FC\uBA39\uC73C\uB85C \uBD88\uD0DC\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507529
    m_Localized: "\uC18D\uB3C4\uB97C \uC62C\uB824 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uB3CC\uC9C4\uD558\uB294 \uCC9C\uB465 \uC0AC\uC2B4\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uBE60\uB97C\uC218\uB85D \uB354 \uC138\uAC8C \uB4E4\uC774\uBC1B\uACE0, \uBD80\uB52A\uD78C \uB4A4\uC5D0\uB294 \uB3C4\uB9DD\uCE58\uBA70 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uC791\uC740 \uBC88\uAC1C\uB97C \uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507530
    m_Localized: "\uC77C\uC815 \uC2DC\uAC04 \uC804\uC7A5\uC5D0 \uB0A8\uC544 \uC788\uB2E4\uAC00,
      \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uC801\uC774 \uC788\uC73C\uBA74 \uADF8 \uC790\uB9AC\uC5D0
      \uAC70\uB300\uD55C \uB3CC\uC8FC\uBA39\uC744 \uC19F\uAD6C\uCE58\uAC8C \uD574
      \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uB294 \uAC70\uC2E0\uC758
      \uC794\uD574\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4. \uD30C\uAD34\uB418\uBA74
      \uB3CC \uBB34\uB354\uAE30\uB97C \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507531
    m_Localized: "\uAC80\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507532
    m_Localized: "\uB9C8\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 1000050
    m_Localized: "\uC544\uC8FC \uB2E8\uB2E8\uD558\uACE0 \uB290\uB9B0 \uBC14\uC704 \uACE8\uB818\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uC9C0\uC0C1\uC758 \uC801\uB9CC \uACF5\uACA9\uD558\uBA70 \uB9DE\uC740 \uC801\uC744 \uBC00\uC5B4\uB0B4\uACE0, \uC4F0\uB7EC\uC9C0\uBA74 \uB3CC \uBB34\uB354\uAE30\uB97C \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000051
    m_Localized: "\uC801\uC774 \uBC94\uC704\uC5D0 \uB4E4\uC5B4\uC624\uBA74 \uC791\uB3D9\uC744 \uC2DC\uC791\uD558\uACE0, \uC7A0\uC2DC \uB4A4\uC5D0\uB3C4 \uBC94\uC704 \uC548\uC5D0 \uC788\uB294 \uBAA8\uB4E0 \uC801\uC744 \uAE30\uC808\uC2DC\uD0A4\uB294 \uD568\uC815\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4. \uD55C \uBC88 \uD130\uC9C0\uBA74 \uC0AC\uB77C\uC9C0\uBA70 \uD53C\uD574\uB294 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000052
    m_Localized: "\uC8FC\uC704 \uC544\uAD70 \uAC74\uBB3C\uC758 \uB0A8\uC740 \uC2DC\uAC04\uC774 \uC904\uC9C0 \uC54A\uAC8C \uBA48\uCD94\uB294 \uD1A0\uD15C\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4. \uCCB4\uB825\uC740 \uD68C\uBCF5\uC2DC\uD0A4\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000053
    m_Localized: "\uD0D1 \uC55E\uCABD \uC815\uD574\uC9C4 \uC790\uB9AC\uB85C \uD3EC\uD0C4\uC744 \uACC4\uC18D \uC3D8\uC544 \uC62C\uB824 \uB5A8\uC5B4\uC9C4 \uACF3\uC744 \uD130\uB728\uB9AC\uB294 \uD0D1\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4. \uC870\uC900\uC740 \uD558\uC9C0 \uC54A\uC73C\uBA70, \uADF8 \uC790\uB9AC\uC5D0 \uC788\uB294 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000054
    m_Localized: "\uC8FC\uC704\uC5D0 \uD480\uBC2D\uC744 \uACC4\uC18D \uD0A4\uC6B0\uB294 \uC124\uCE58\uBB3C\uC744 \uB9CC\uB4ED\uB2C8\uB2E4. \uD480\uBC2D\uC740 \uC801\uC744 \uC5BD\uC5B4\uB9E4\uACE0 \uC544\uAD70\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uBA70, \uAC00\uAE4C\uC774 \uC788\uB294 \uC544\uAD70 \uC528\uC557 \uC815\uB839\uC740 \uB369\uAD74\uC744 \uC77C\uC73C\uCF1C \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000055
    m_Localized: "\uC801 \uC9C4\uC601 \uCABD\uC73C\uB85C \uC77C\uC9C1\uC120\uC73C\uB85C \uBD88\uD0C0\uB294 \uD654\uC5FC\uD0C4\uC744 \uACC4\uC18D \uC3D8\uB294 \uD0D1\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4. \uC870\uC900\uC740 \uD558\uC9C0 \uC54A\uACE0, \uC120 \uC704\uC5D0\uC11C \uCC98\uC74C \uB9DE\uC740 \uC9C0\uC0C1 \uC801\uC744 \uBD88\uD0DC\uC6B0\uBA70, \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000056
    m_Localized: "\uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uBB3C \uC9C0\uB300\uB97C
      \uB0A8\uAE30\uB294 \uB290\uB9B0 \uC9C0\uC0C1 \uBC14\uB2E4\uBC40\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4.
      \uC77C\uC9C1\uC120\uC73C\uB85C \uBB3C\uC904\uAE30\uB97C \uBFDC\uC5B4 \uC120
      \uC704\uC5D0 \uC788\uB294 \uC801\uC744 \uACF5\uC911 \uC720\uB2DB\uAE4C\uC9C0
      \uD55C\uAEBC\uBC88\uC5D0 \uB9DE\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000057
    m_Localized: "\uC544\uAD70\uC758 \uCCB4\uB825\uC744 \uC808\uBC18\uAE4C\uC9C0
      \uB04C\uC5B4\uBAA8\uC544, \uADF8\uB9CC\uD07C\uC758 \uD798\uC744 \uBE54\uC73C\uB85C
      \uC3E9\uB2C8\uB2E4. \uBE54\uC740 \uB124 \uBC88\uC5D0 \uB098\uB220 \uBC29\uD5A5
      \uC704\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744 \uB54C\uB9AC\uACE0,
      \uC801\uC774 \uC4F0\uB7EC\uC9C0\uBA74 \uB0A8\uC740 \uD53C\uD574\uAC00 \uB2E4\uC74C
      \uC801\uC5D0\uAC8C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000058
    m_Localized: "\uC870\uC900\uD55C \uACF3\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uC801\uC744 \uCAD3\uC544\uAC00\uB294 \uC720\uB3C4 \uD0C4\uB450\uB97C \uC3E9\uB2C8\uB2E4.
      \uACF5\uC911 \uC801\uC744 \uBA3C\uC800 \uB178\uB9AC\uACE0 \uC5C6\uC73C\uBA74
      \uC9C0\uC0C1 \uC801\uC744 \uB178\uB9AC\uBA70, \uAC00\uB294 \uAE38\uC5D0 \uCC98\uC74C
      \uB2FF\uC740 \uC801\uC5D0\uAC8C\uC11C \uD130\uC838 \uC8FC\uBCC0 \uC801\uC744
      \uD568\uAED8 \uB9DE\uD799\uB2C8\uB2E4. \uACF5\uC911 \uC801\uC744 \uB178\uB9B4
      \uB54C \uD53C\uD574\uAC00 \uB354 \uD07D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000059
    m_Localized: "\uC55E\uC73C\uB85C \uB0A0\uC544\uAC00 \uACBD\uB85C\uC0C1 \uCC98\uC74C
      \uB9DE\uC740 \uC801\uC744 \uB4A4\uB85C \uB0A0\uB824 \uBCF4\uB0B4\uACE0 \uC7A0\uC2DC
      \uAE30\uC808\uC2DC\uD0A4\uB294 \uBC14\uC704\uB97C \uB358\uC9D1\uB2C8\uB2E4.
      \uBC00\uB824\uB09C \uC801\uC774 \uBCBD, \uB3CC \uBB34\uB354\uAE30, \uB2E4\uB978
      \uC801\uC5D0 \uBD80\uB52A\uD788\uBA74 \uCD94\uAC00 \uD53C\uD574\uB97C \uBC1B\uACE0,
      \uBD80\uB52A\uD78C \uC801\uB3C4 \uD568\uAED8 \uD53C\uD574\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000060
    m_Localized: "\uC9C0\uC0C1\uC758 \uC801 \uC704\uB85C \uB0A0\uC544\uAC00 \uD3ED\uD0C4\uC744
      \uB5A8\uC5B4\uB728\uB9AC\uB294 \uBE44\uD589 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4.
      \uD3ED\uD0C4\uC740 \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uC5D0\uC11C \uD130\uC838
      \uC8FC\uBCC0 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0,
      \uC815\uB839\uC740 \uACF5\uC911 \uC801\uC744 \uB178\uB9AC\uC9C0 \uC54A\uC73C\uBA70
      \uACF5\uACA9\uD574\uB3C4 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000061
    m_Localized: "\uAC70\uB300 \uB369\uAD74\uC744 \uC2EC\uC5B4 \uADF8 \uB458\uB808\uC758
      \uC801\uC5D0\uAC8C \uACE7\uBC14\uB85C \uD53C\uD574\uB97C \uC8FC\uACE0 \uB290\uB9AC\uAC8C
      \uB9CC\uB4E0 \uB4A4, \uC7A0\uC2DC \uB4A4 \uB369\uAD74 \uB450 \uACB9\uC744 \uB3CB\uC544\uB098\uAC8C
      \uD574 \uB2FF\uC740 \uC801\uC5D0\uAC8C \uD55C \uBC88 \uB354 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4. \uB369\uAD74\uC5D0 \uB9DE\uC740 \uC801\uB9C8\uB2E4 \uC544\uAD70
      \uC528\uC557 \uC815\uB839\uC774 \uC0DD\uAE30\uACE0, \uB369\uAD74\uC5D0 \uB2FF\uC740
      \uC544\uAD70 \uC528\uC557 \uC815\uB839\uC740 \uD480 \uC815\uB839\uC73C\uB85C
      \uC790\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000062
    m_Localized: "\uC77C\uC815 \uAC04\uACA9\uC73C\uB85C \uC9C0\uC0C1 \uC528\uC557
      \uC815\uB839\uC744 \uACC4\uC18D \uB9CC\uB4E4\uC5B4 \uB0B4\uB294 \uB465\uC9C0\uB97C
      \uC124\uCE58\uD569\uB2C8\uB2E4. \uB465\uC9C0\uB294 \uC2DC\uAC04\uC774 \uB2E4\uD558\uAC70\uB098
      \uD30C\uAD34\uB418\uBA74 \uC0AC\uB77C\uC9C0\uACE0, \uC528\uC557 \uC815\uB839\uC740
      \uADFC\uC811 \uACF5\uACA9\uC744 \uD558\uBA70 \uAC78\uC73C\uBA74\uC11C \uD480\uBC2D\uC744
      \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000063
    m_Localized: "\uBAA9\uB85D\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1000064
    m_Localized: "\uBAA8\uB4E0 \uC885\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 1000065
    m_Localized: "\uC720\uB2DB"
    m_Metadata:
      m_Items: []
  - m_Id: 1000066
    m_Localized: "\uAC74\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 1000067
    m_Localized: "\uB4DC\uB78D"
    m_Metadata:
      m_Items: []
  - m_Id: 1000068
    m_Localized: "\uD3ED\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 1000069
    m_Localized: "\uC29B"
    m_Metadata:
      m_Items: []
  - m_Id: 1000070
    m_Localized: "\uBAA8\uB4E0 \uB9C8\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 1000071
    m_Localized: "\uC120\uD0DD\uD55C \uC790\uB9AC\uB97C \uC9C4\uB3D9\uC2DC\uCF1C
      \uBC94\uC704 \uC548\uC758 \uB3CC \uBB34\uB354\uAE30\uB97C \uBAA8\uB450 \uB0B4
      \uC720\uB2DB\uC73C\uB85C \uC77C\uC73C\uCF1C \uC138\uC6C1\uB2C8\uB2E4. \uB204\uAC00
      \uB0A8\uAE34 \uAC83\uC774\uB4E0 \uC18C\uD615\uC740 \uBBF8\uB2C8\uB85D, \uC911\uD615\uC740
      \uB3CC \uACE8\uB818\uC774 \uB418\uBA70 \uB3CC \uBB34\uB354\uAE30\uAC00 \uC5C6\uC73C\uBA74
      \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000072
    m_Localized: "\uBC94\uC704 \uC548\uC758 \uB3CC \uBB34\uB354\uAE30\uB97C \uBAA8\uB450
      \uD130\uB728\uB9BD\uB2C8\uB2E4. \uB204\uAC00 \uB0A8\uAE34 \uAC83\uC774\uB4E0
      \uC7A0\uC2DC \uB4A4\uC5D0 \uD3ED\uBC1C\uD574 \uC8FC\uC704\uC758 \uBAA8\uB4E0
      \uC720\uB2DB\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0, \uC544\uAD70\uB3C4
      \uB9DE\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC911\uD615 \uB3CC \uBB34\uB354\uAE30\uB294
      \uD3ED\uBC1C \uB4A4 \uC18C\uD615 \uB3CC \uBB34\uB354\uAE30\uB97C \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000073
    m_Localized: "\uBC29\uC5B4 \uC6D0\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 1000074
    m_Localized: "\uACF5\uACA9 \uC6D0\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 1000075
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC9C0\uC0C1 \uC801\uC5D0\uAC8C
      \uC77C\uC9C1\uC120\uC73C\uB85C \uCF69\uC744 \uC3D8\uB294 \uC9C0\uC0C1 \uC720\uB2DB\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4. \uCF69\uC740 \uACBD\uB85C\uC0C1 \uCC98\uC74C
      \uB2FF\uB294 \uC9C0\uC0C1 \uC801\uC744 \uB9DE\uD788\uBA70 \uACF5\uC911 \uC720\uB2DB\uC740
      \uB9DE\uD788\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
