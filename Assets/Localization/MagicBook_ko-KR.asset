  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1000000
    m_Localized: "\uC804\uC7C1\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC740 \uBB3C \uC2AC\uB77C\uC784 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4. \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uBB3C\uC758 \uC9C0\uB300\uB97C \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000001
    m_Localized: "\uC9C0\uC625\uBD88 \uCC28\uC6D0\uC758 \uD654\uC5FC\uD0C4\uC744 \uBAA9\uD45C \uBC29\uD5A5\uC73C\uB85C \uC3D8\uC544 \uBCF4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000002
    m_Localized: "\uC19F\uAD6C\uCE58\uB294 \uAC04\uD5D0\uCC9C\uC73C\uB85C \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uACF5\uC911\uC73C\uB85C \uB744\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000003
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB9C8\uB3C4 \uB300\uD3EC\uB97C \uC138\uC6CC \uC9C0\uC0C1 \uC720\uB2DB\uC744 \uD3EC\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000004
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB300\uACF5 \uB9C8\uB3C4\uD0D1\uC744 \uC138\uC6CC \uACF5\uC911 \uC720\uB2DB\uC744 \uBC94\uC704 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000005
    m_Localized: "\uC138\uACC4\uC218\uC758 \uB9C8\uB825\uC774 \uACE0\uC778 \uC0D8\uC744 \uC5F4\uC5B4 \uB9C8\uB098\uB97C \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000006
    m_Localized: "\uC7A5\uBE44\uB97C \uB2E4\uB8E8\uB294 \uBB3C \uC2AC\uB77C\uC784 \uAD81\uC218\uB97C \uC18C\uD658\uD574 \uC9C0\uC0C1\uACFC \uACF5\uC911\uC744 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000007
    m_Localized: "\uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uC774\uB07C\uBC14\uC704 \uC804\uC0AC\uB97C \uBD88\uB7EC \uC9C0\uC0C1 \uC801\uC744 \uADFC\uC811 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000008
    m_Localized: "\uC138\uACC4\uC218\uC758 \uBC14\uB78C \uC815\uB839 \uAE30\uC218\uB97C \uBD88\uB7EC \uD50C\uB808\uC774\uC5B4\uB97C \uC6B0\uC120 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000009
    m_Localized: "\uC138\uACC4\uC218\uC5D0\uC11C \uD0DC\uC5B4\uB09C \uC804\uAE30 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \uBE60\uB974\uAC8C \uB0A0\uBA70 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000010
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uD558\uAE09 \uC545\uB9C8\uB97C \uBD88\uB7EC \uC8FC\uBCC0 \uC801\uC744 \uBD88\uD0DC\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000011
    m_Localized: "\uC804\uAE30 \uC815\uB839\uC758 \uB099\uB8B0\uB97C \uBAA9\uD45C \uC9C0\uC810\uC5D0 \uB0B4\uB9AC\uAF42\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000012
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uC6A9\uC554 \uAC11\uAC01 \uC545\uB9C8\uB97C \uBD88\uB7EC \uC801\uC744 \uBD88\uD0DC\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000013
    m_Localized: "\uC138\uACC4\uC218\uC758 \uCE58\uC720 \uD1A0\uD15C\uC744 \uC138\uC6CC \uBC94\uC704 \uC548 \uC544\uAD70\uC744 \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000014
    m_Localized: "\uBC14\uB78C \uC815\uB839\uC758 \uD669\uC9C4 \uD3ED\uD48D\uC744 \uC77C\uC73C\uCF1C \uBC94\uC704\uC758 \uC801\uC744 \uBAB0\uC544\uCE69\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000015
    m_Localized: "\uD68C\uC624\uB9AC\uB85C \uD654\uD55C \uBC14\uB78C \uC815\uB839\uC774 \uC804\uC7A5\uC744 \uD729\uC4F8\uBA70 \uC801\uC744 \uC4F8\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000016
    m_Localized: "\uC9C0\uC625\uBD88 \uCC28\uC6D0\uC758 \uC720\uC131\uC6B0\uB97C \uB113\uC740 \uBC94\uC704\uC5D0 \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000017
    m_Localized: "\uAD6C\uB984\uBE44\uB298\uC758 \uBC14\uB78C \uC815\uB839 \uC6B4\uB8E1\uC744 \uC18C\uD658\uD574 \uC8FC\uBCC0\uC744 \uC801\uC2DC\uACE0 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000018
    m_Localized: "\uC138\uACC4\uC218\uC758 \uCC9C\uB465\uC0C8 \uD3B8\uB300\uB97C \uBD88\uB7EC \uB3CC\uC9C4 \uACF5\uACA9\uC744 \uD37C\uBD93\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000019
    m_Localized: "\uC138\uACC4\uC218\uC758 \uACE0\uBAA9 \uC218\uD638\uC790\uB97C \uBD88\uB7EC \uB290\uB9AC\uC9C0\uB9CC \uB2E8\uB2E8\uD558\uAC8C \uC9C0\uC0C1 \uC801\uACFC \uB9DE\uC12D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000020
    m_Localized: "\uB369\uAD74\uB85C \uBAB8\uC744 \uC5EE\uC740 \uC138\uACC4\uC218\uC758 \uD480 \uC815\uB839\uC744 \uC18C\uD658\uD574 \uC801\uC744 \uB4A4\uCAD3\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000021
    m_Localized: "\uB369\uAD74 \uAD70\uB77D\uC744 \uC2EC\uC5B4 \uB369\uAD74\uC744 \uACC4\uC18D \uB0B4\uBCF4\uB0B4\uBA70 \uC801\uC744 \uD1F4\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000022
    m_Localized: "\uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uB8EC\uBC14\uC704 \uC8FC\uC220\uC0AC\uB97C \uBD88\uB7EC \uB450 \uAC1C\uC758 \uBC14\uC704\uB85C \uC801\uC744 \uD0C0\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000023
    m_Localized: "\uC138\uACC4\uC218\uC5D0\uC11C \uB5A8\uC5B4\uC9C4 \uC791\uC740 \uC528\uC557 \uC815\uB839 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000024
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uC791\uC740 \uC7BF\uBD88 \uC545\uB9C8 \uBB34\uB9AC\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000025
    m_Localized: "\uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uAF2C\uB9C8\uB3CC \uC30D\uB465\uC774\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000026
    m_Localized: "\uC9C8\uD48D\uC758 \uBC14\uB78C \uC815\uB839\uC744 \uC18C\uD658\uD574 \uC801\uC5D0\uAC8C \uB2EC\uB824\uB4E4\uC5B4 \uC790\uD3ED\uD558\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000027
    m_Localized: "\uC9C0\uC625\uBD88 \uCC28\uC6D0\uC758 \uC6A9\uC554 \uADE0\uC5F4\uC744 \uC5F4\uC5B4 \uBC94\uC704\uB97C \uD0DC\uC6CC\uBC84\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000028
    m_Localized: "\uBC14\uB78C \uC815\uB839\uC758 \uC21C\uD48D \uD1A0\uD15C\uC744 \uC138\uC6CC \uC801\uC744 \uC77C\uC815\uD55C \uBC29\uD5A5\uC73C\uB85C \uBC00\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000029
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uC791\uC740 \uD22C\uC11D \uD3EC\uD0D1\uC744 \uC138\uC6CC \uBC14\uC704\uB97C \uC3D8\uC544 \uBCF4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000030
    m_Localized: "\uC138\uACC4\uC218\uC758 \uBB18\uBAA9\uC744 \uC2EC\uC5B4 \uC8FC\uBCC0 \uC544\uAD70\uC744 \uC9C0\uC18D \uD68C\uBCF5\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000031
    m_Localized: "\uCD08\uC2B9\uB2EC \uBAA8\uC591\uC758 \uBC14\uB78C \uCE7C\uB0A0\uC744 \uB0A0\uB824 \uC801\uB4E4\uC744 \uAFF0\uB6AB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000032
    m_Localized: "\uC138\uACC4\uC218\uC758 \uB369\uAD74\uC744 \uC77C\uB82C\uB85C \uC5F0\uB2EC\uC544 \uC19F\uAD6C\uCE58\uAC8C \uD574 \uC801\uC744 \uD0C0\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000033
    m_Localized: "\uBB3C \uC2AC\uB77C\uC784\uC758 \uD574\uC77C\uC744 \uBD88\uB7EC \uC801\uC744 \uBC00\uC5B4\uB0B4\uBA70 \uBB3C\uAE38\uC744 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000034
    m_Localized: "\uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uAC70\uC11D\uC744 \uAD74\uB824 \uC801\uACFC \uBCBD\uC5D0 \uD295\uAE30\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000035
    m_Localized: "\uC804\uAE30 \uC815\uB839\uC758 \uB1CC\uAD11\uC774 \uC801\uB4E4 \uC0AC\uC774\uB97C \uD295\uAE30\uBA70 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000036
    m_Localized: "\uBE44\uB97C \uBFCC\uB9AC\uB294 \uAD6C\uB984\uC744 \uBD88\uB7EC \uC804\uC7A5\uC744 \uC801\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000037
    m_Localized: "\uC138\uACC4\uC218\uC758 \uB9C8\uB825\uC774 \uB9FA\uD78C \uB3C4\uAE68\uBE44\uBD88\uC744 \uB0A0\uB824 \uC801\uC758 \uD1B5\uC81C\uAD8C\uC744 \uBE7C\uC557\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000038
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uAD11\uB780 \uD1A0\uD15C\uC744 \uB5A8\uC5B4\uB728\uB824 \uBC94\uC704 \uC548 \uC720\uB2DB\uC774 \uC544\uAD70\uAE4C\uC9C0 \uACF5\uACA9\uD558\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000039
    m_Localized: "\uC78E\uBC14\uB78C \uC694\uC815\uC744 \uB0B4\uB824\uBCF4\uB0B4 \uC544\uAD70 \uAC74\uBB3C\uC744 \uC218\uB9AC\uD558\uACE0 \uC9C0\uC18D \uC2DC\uAC04\uC744 \uB298\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000040
    m_Localized: "\uD558\uB298\uC5D0\uC11C \uB3CC \uACE8\uB818 \uBD80\uC871\uC758 \uAC70\uC11D\uC744 \uB5A8\uC5B4\uB728\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000041
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uACF5\uC218 \uD2B9\uACF5\uB300\uB97C \uB099\uD558\uC0B0\uC73C\uB85C \uD22C\uC785\uD574 \uC9C0\uC0C1 \uC801\uACFC \uB9DE\uC12D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000042
    m_Localized: "\uC138\uACC4\uC218\uC758 \uACFC\uC0DD\uC7A5\uC744 \uC77C\uC73C\uCF1C \uC791\uC740 \uC0DD\uBA85\uC744 \uD06C\uAC8C \uC790\uB77C\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000043
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC758 \uC7BF\uBD88 \uBD84\uD654\uAD6C\uB97C \uB0A8\uACA8 \uC8FC\uBCC0\uC5D0 \uBD88\uB369\uC774\uB97C \uBFDC\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000044
    m_Localized: "\uAC74\uBB3C\uC744 \uC88B\uC544\uD558\uB294 \uAC81 \uB9CE\uC740 \uC804\uAE30 \uC815\uB839 \uC950\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000045
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uC9D1\uACB0 \uC2E0\uD638\uD0D1\uC744 \uC138\uC6CC \uC8FC\uBCC0 \uC544\uAD70\uC744 \uBAA8\uC73C\uACE0 \uADFC\uCC98 \uC801\uC744 \uACF5\uACA9\uD558\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000046
    m_Localized: "\uC804\uAE30 \uC815\uB839\uC758 \uB1CC\uAD11\uC744 \uD130\uB728\uB824 \uC8FC\uBCC0 \uC801\uC744 \uAC10\uC804\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000047
    m_Localized: "\uBC14\uB78C \uC815\uB839\uC758 \uCE7C\uBC14\uB78C \uD68C\uC624\uB9AC\uAC00 \uBC94\uC704\uC758 \uC801\uC744 \uC9C0\uC18D\uD574\uC11C \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000048
    m_Localized: "\uBB3C \uC2AC\uB77C\uC784\uC758 \uAC70\uD488 \uBC30\uC591\uAE30\uB97C \uC124\uCE58\uD574 \uC544\uAD70\uC744 \uAC10\uC2F8 \uBCF4\uD638\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000049
    m_Localized: "\uC778\uAC04 \uB9C8\uBC95 \uBB38\uBA85\uC758 \uB1CC\uC804 \uB9C8\uB3C4\uD0D1\uC744 \uC138\uC6CC \uD295\uAE30\uB294 \uC804\uAE30\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864653363056640
    m_Localized: "\uCC28\uC6D0 \uC720\uB791\uC885 \uACBD\uACC4 \uC6B4\uBC18\uC790\uB97C \uBD88\uB7EC \uD654\uC0B0\uD3B8\uACFC \uD3ED\uD48D\uD3B8\uC758 \uD1B5\uB85C\uB97C \uBC88\uAC08\uC544 \uC5FD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864718152470528
    m_Localized: "\uC9C0\uC625\uBD88 \uAD70\uB2E8\uC7A5\uC744 \uBD88\uB7EC \uC801\uC744 \uACF5\uACA9\uD558\uB294 \uD558\uAE09 \uC545\uB9C8\uB97C \uACC4\uC18D \uB0B4\uBCF4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864733830778880
    m_Localized: "\uAC70\uD488\uC744 \uB2E4\uB8E8\uB294 \uBB3C \uC2AC\uB77C\uC784\uC744 \uC18C\uD658\uD574 \uD130\uC9C0\uB294 \uAC70\uD488\uC73C\uB85C \uACF5\uC911 \uC720\uB2DB\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864741510549504
    m_Localized: "\uC804\uAE30 \uC815\uB839\uC758 \uB1CC\uAD11\uC744 \uACFC\uBD80\uD558\uC2DC\uCF1C \uAC15\uB825\uD55C \uAC10\uC804\uACFC \uB300\uACF5 \uD3ED\uBC1C\uC744 \uC77C\uC73C\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507520
    m_Localized: "\uB4F1\uC5D0 \uC778\uAC04\uC81C \uC9C0\uB300\uACF5 \uD3EC\uD0D1\uC744 \uACB0\uC18D\uB2F9\uD55C \uAF2C\uB9C8\uB3CC\uC744 \uC18C\uD658\uD574 \uACF5\uC911 \uC720\uB2DB\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507521
    m_Localized: "\uC815\uB82C"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507522
    m_Localized: "\uC18D\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507523
    m_Localized: "\uD0C0\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507524
    m_Localized: "\uC804\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507525
    m_Localized: "\uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507526
    m_Localized: "\uC18D\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507527
    m_Localized: "\uCE74\uB4DC \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507528
    m_Localized: "\uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744 \uB54C\uB9AC\uACE0
      \uC8FC\uAE30\uC801\uC73C\uB85C \uAC00\uBCBC\uC6B4 \uC801\uC744 \uB04C\uC5B4\uB2F9\uACA8
      \uBD88\uD0DC\uC6B0\uB294 \uC0AC\uC545\uD55C \uB098\uBB34 \uACE8\uB818\uC744
      \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507529
    m_Localized: "\uB3CC\uC9C4\uD558\uC5EC \uC801\uB4E4\uC744 \uACF5\uACA9\uD558\uB294 \uCC9C\uB465 \uC0AC\uC2B4\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1864750230507530
    m_Localized: "\uAC70\uC2E0\uC758 \uC794\uD574\uB97C \uC18C\uD658\uD569\uB2C8\uB2E4.
      \uAC70\uC2E0\uC758 \uC794\uD574\uB294 \uC77C\uC815 \uC2DC\uAC04 \uB3D9\uC548
      \uC804\uC7A5\uC5D0 \uB0A8\uC544 \uC8FC\uAE30\uC801\uC73C\uB85C \uC8FC\uBCC0
      \uC801\uC758 \uC704\uCE58\uC5D0 \uAC70\uB300\uD55C \uB3CC\uC8FC\uBA39\uC744
      \uC19F\uAD6C\uCE58\uAC8C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000050
    m_Localized: "\uC9C0\uC0C1\uC758 \uC801\uB9CC \uC0C1\uB300\uD558\uB294 \uD06C\uACE0 \uB2E8\uB2E8\uD55C \uBC14\uC704 \uACE8\uB818\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000051
    m_Localized: "\uC801\uC774 \uB4E4\uC5B4\uC624\uBA74 \uC7A0\uC2DC \uB4A4 \uD130\uC838 \uC8FC\uC704\uB97C \uAE30\uC808\uC2DC\uD0A4\uB294 \uD568\uC815\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000052
    m_Localized: "\uC8FC\uC704 \uC544\uAD70 \uAC74\uBB3C\uC774 \uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uAC8C \uD558\uB294 \uD1A0\uD15C\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000053
    m_Localized: "\uD3EC\uD0C4\uC744 \uD3EC\uBB3C\uC120\uC73C\uB85C \uC3D8\uC544 \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uB97C \uD130\uB728\uB9AC\uB294 \uD0D1\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000054
    m_Localized: "\uC8FC\uC704\uC5D0 \uD480\uBC2D\uC744 \uACC4\uC18D \uD37C\uB728\uB9AC\uB294 \uC124\uCE58\uBB3C\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000055
    m_Localized: "\uACF5\uC911\uACFC \uC9C0\uC0C1\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uACE0 \uD654\uC5FC\uD0C4\uC744 \uC3D8\uB294 \uD0D1\uC744 \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000056
    m_Localized: "\uC774\uB3D9\uD55C \uC790\uB9AC\uC5D0 \uBB3C \uC9C0\uB300\uB97C
      \uB0A8\uAE30\uACE0, \uC77C\uC9C1\uC120\uC73C\uB85C \uBB3C\uC904\uAE30\uB97C
      \uBFDC\uC5B4 \uC120 \uC704\uC758 \uC801\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uB9DE\uD788\uB294
      \uBC14\uB2E4\uBC40\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000057
    m_Localized: "\uC544\uAD70 \uC720\uB2DB\uC758 \uCCB4\uB825\uC744 \uC808\uBC18\uAE4C\uC9C0
      \uB04C\uC5B4\uBAA8\uC544, \uBAA8\uC740 \uC591\uC758 70%\uB97C \uB124 \uBC88\uC5D0
      \uB098\uB220 \uC801\uC5D0\uAC8C \uB0B4\uB9AC\uAF42\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000058
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uACF5\uC911 \uC801\uC744 \uCAD3\uC544\uAC00
      \uD130\uC9C0\uB294 \uD0C4\uB450\uB97C \uC3D8\uACE0, \uACF5\uC911\uC5D0 \uC801\uC774
      \uC5C6\uC73C\uBA74 \uC9C0\uC0C1 \uC801\uC744 \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000059
    m_Localized: "\uB9DE\uC740 \uC801\uC744 \uB4A4\uB85C \uBC00\uC5B4\uB0B4\uB294
      \uBC14\uC704\uB97C \uB0A0\uB9AC\uACE0, \uBC00\uB824\uB09C \uC801\uC774 \uBCBD\uC774\uB098
      \uB2E4\uB978 \uC801\uC5D0 \uBD80\uB52A\uD788\uBA74 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000060
    m_Localized: "\uC9C0\uC0C1\uC758 \uC801 \uC704\uB85C \uB0A0\uC544\uAC00 \uD3ED\uD0C4\uC744
      \uB5A8\uC5B4\uB728\uB9AC\uACE0 \uB5A8\uC5B4\uC9C4 \uC790\uB9AC\uB97C \uD130\uB728\uB9AC\uB294
      \uBE44\uD589 \uC815\uB839\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000061
    m_Localized: "\uAC70\uB300 \uB369\uAD74\uC744 \uC2EC\uACE0, \uC7A0\uC2DC \uB4A4
      \uADF8 \uB458\uB808\uC5D0 \uB369\uAD74 \uB450 \uACB9\uC744 \uB3CB\uC544\uB098\uAC8C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000062
    m_Localized: "\uC528\uC557 \uC815\uB839\uC744 \uC77C\uC815 \uAC04\uACA9\uC73C\uB85C
      \uACC4\uC18D \uB0B4\uBCF4\uB0B4\uB294 \uB465\uC9C0\uB97C \uC124\uCE58\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1000063
    m_Localized: "\uBAA9\uB85D\uC73C\uB85C"
    m_Metadata:
      m_Items: []
