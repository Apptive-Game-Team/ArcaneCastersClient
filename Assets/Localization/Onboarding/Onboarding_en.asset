  m_TableData:
  - m_Id: 318000000001
    m_Localized: "Want to try the tutorial?"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000002
    m_Localized: "New here? We will show you around"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000003
    m_Localized: "Yes"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000004
    m_Localized: "No"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000005
    m_Localized: "Deck"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000007
    m_Localized: "A deck holds 15 cards"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000009
    m_Localized: "Save your deck before you leave"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000011
    m_Localized: "You can keep this deck. Press the lobby button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000012
    m_Localized: "Magic Book"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000013
    m_Localized: "The Magic Book shows spell details"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000014
    m_Localized: "Take Grass Seed Slime as an example"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000015
    m_Localized: "Press the element chart button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000016
    m_Localized: "Guide done. Press the lobby button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000017
    m_Localized: "Matching"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000018
    m_Localized: "Pick your deck from the list on the right"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000019
    m_Localized: "Test your skills against other players"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000020
    m_Localized: "Or practice against bots"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000021
    m_Localized: "You can go on adventures too"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000022
    m_Localized: "Menu"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000023
    m_Localized: "The menu opens your profile, friends, appearance, chests and settings."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000024
    m_Localized: "Tutorial complete"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000025
    m_Localized: "Next"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000026
    m_Localized: "Done"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000027
    m_Localized: "Press the Deck button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000029
    m_Localized: "Press the Magic Book button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000030
    m_Localized: "Tap any spell"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000031
    m_Localized: "Read the spell description"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000032
    m_Localized: "The chart shows element matchups"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000033
    m_Localized: "Tap where the spell should land"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000035
    m_Localized: "Casting failed. Try an outlined card"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000036
    m_Localized: "Cast a spell with an outlined card"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000037
    m_Localized: "Tap the mana bar to open your cards"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000038
    m_Localized: "Try a practice match against a bot"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000039
    m_Localized: "Press the bot match button to play your first match"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000040
    m_Localized: "First match done! Now play as you like"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000041
    m_Localized: "Pick a deck or make a new one here"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000042
    m_Localized: "Cards in this deck. Press one to take it out"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000043
    m_Localized: "Your cards. Press one to put it in the deck"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000044
    m_Localized: "Each card shows the mana it costs"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000045
    m_Localized: "Changed your deck? Save it here"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000046
    m_Localized: "Long ago, a great archmage lived on the continent of Word."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000047
    m_Localized: "Ten thousand years ago, the World Tree grew where he died."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000048
    m_Localized: "And now, a gate to another dimension has opened."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000049
    m_Localized: "Attack."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000050
    m_Localized: "Destroy the enemy before you."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000051
    m_Localized: "Everyone, fall back!\nProtect the World Tree!"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000052
    m_Localized: "And so, war began on the continent of Word."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000053
    m_Localized: "Keep going."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000054
    m_Localized: "Skip"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000055
    m_Localized: "Click / Space to continue"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000056
    m_Localized: "Start tutorial"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000057
    m_Localized: "Choose your faction"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000058
    m_Localized: "Loading your starting spells."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000059
    m_Localized: "Preparing your tutorial battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000060
    m_Localized: "Receive 3 copies of each of your faction’s 5 starting spells. You can collect the other faction’s spells later.\nInferno & Stone: Fire Shot · Ember Swarm · Towerback · Rock Golem · Fire Explosion\nNature & Water: Chain Lightning · Water Slime Swarm · Vine Spirit · Tree Golem · Water Explosion"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000061
    m_Localized: "Inferno & Stone"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000062
    m_Localized: "Nature & Water"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000063
    m_Localized: "Try again"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000064
    m_Localized: "Next battle"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000065
    m_Localized: "Restart tutorial"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000066
    m_Localized: "Check your connection and try again. We will reconnect to your battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000067
    m_Localized: "Restart the lessons with your selected faction."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000068
    m_Localized: "Check your spell, mana and aim, then try casting again."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000069
    m_Localized: "Open the mana bar, select Fire Shot, then aim at the nature scout."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000070
    m_Localized: "Open the mana bar and aim Chain Lightning at the clustered enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000071
    m_Localized: "Support spell trial: drop Meteor Shower on the enemy group. It is available for this lesson only."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000072
    m_Localized: "Support spell trial: drop Meteor Shower on the enemy group. It is available for this lesson only."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000073
    m_Localized: "Support spell trial: summon Tornado Strike in front of the approaching enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000074
    m_Localized: "Support spell trial: summon Tornado Strike in front of the approaching enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000075
    m_Localized: "Deploy Towerback to shoot down the flying enemy."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000076
    m_Localized: "Deploy Vine Spirits to shoot down the flying enemy."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000077
    m_Localized: "Deploy your golem at the front. Your swarm becomes available when the golem takes a hit."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000078
    m_Localized: "Your golem is taking the hits. Summon a swarm behind or beside it to help attack."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000079
    m_Localized: "Fire is strong against Nature. Use Fire Explosion on the clustered nature enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000080
    m_Localized: "Water is strong against Fire. Use Water Explosion on the clustered ember spirits."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000081
    m_Localized: "Final battle: use your five starting spells freely to stop the ground enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000082
    m_Localized: "An airborne enemy has joined. Respond with your remaining allies and spells."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000083
    m_Localized: "The final enemies are clustered together. Use what you learned to finish the battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000084
    m_Localized: "Enemies defeated"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000085
    m_Localized: "A larger group of enemies awaits in the next battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000086
    m_Localized: "Try Tornado Strike in the next battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000087
    m_Localized: "Now try the starting spells of your faction."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000088
    m_Localized: "Next, summon a golem and a swarm together."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000089
    m_Localized: "Next, exploit elemental weaknesses."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000090
    m_Localized: "Use the spells you learned freely in the final battle."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000091
    m_Localized: "Lesson failed"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000092
    m_Localized: "Restart just this lesson with your mana and spells ready."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000093
    m_Localized: "Tutorial complete"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000094
    m_Localized: "Your Inferno & Stone starting deck is ready.\nFire Shot · Ember Swarm · Towerback · Rock Golem · Fire Explosion\nMeteor Shower and Tornado Strike were trial spells. You can obtain them later."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000095
    m_Localized: "Your Nature & Water starting deck is ready.\nChain Lightning · Water Slime Swarm · Vine Spirit · Tree Golem · Water Explosion\nMeteor Shower and Tornado Strike were trial spells. You can obtain them later."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000096
    m_Localized: "Enter lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000113
    m_Localized: "The meteors are falling. Finish any remaining enemies with your starting shot spell."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000114
    m_Localized: Choose a faction
    m_Metadata:
      m_Items: []
  - m_Id: 318000000115
    m_Localized: Hellfire Legion
    m_Metadata:
      m_Items: []
  - m_Id: 318000000116
    m_Localized: World Tree Spirits
    m_Metadata:
      m_Items: []
  - m_Id: 318000000117
    m_Localized: "Loading starting spells"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000118
    m_Localized: "Connecting to the tutorial battle"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000119
    m_Localized: "Could not connect to the battle"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000120
    m_Localized: "Tutorial battle ended"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000121
    m_Localized: "Cannot cast this spell yet"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000122
    m_Localized: "Continue lesson"
    m_Metadata:
      m_Items: []
