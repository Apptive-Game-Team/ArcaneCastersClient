    m_Metadata:
      m_Items: []
  - m_Id: 318000000017
    m_Localized: "Matching"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000018
    m_Localized: "Pick your deck from the list on the right"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000019
    m_Localized: "Test your skills against other players"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000020
