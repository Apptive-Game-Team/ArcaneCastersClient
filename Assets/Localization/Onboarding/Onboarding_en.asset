  - m_Id: 318000000001
    m_Localized: "Want to try the tutorial?"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000002
    m_Localized: "New here? We will show you around"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000003
    m_Localized: "Yes"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000004
    m_Localized: "No"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000005
    m_Localized: "Deck"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000007
    m_Localized: "A deck holds 15 cards"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000009
    m_Localized: "Save your deck before you leave"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000011
    m_Localized: "Saved. Press the lobby button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000012
    m_Localized: "Magic Book"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000013
    m_Localized: "The Magic Book shows spell details"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000014
    m_Localized: "Take Grass Seed Slime as an example"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000015
    m_Localized: "Press the element chart button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000016
