  m_TableData:
  - m_Id: 318000000001
    m_Localized: "Want to try the tutorial?"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000002
    m_Localized: "New here? We will show you around"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000003
    m_Localized: "Yes"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000004
    m_Localized: "No"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000005
    m_Localized: "Deck"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000007
    m_Localized: "A deck holds 15 cards"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000009
    m_Localized: "Save your deck before you leave"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000011
    m_Localized: "You can keep this deck. Press the lobby button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000012
    m_Localized: "Magic Book"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000013
    m_Localized: "The Magic Book shows spell details"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000014
    m_Localized: "Take Grass Seed Slime as an example"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000015
    m_Localized: "Press the element chart button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000016
    m_Localized: "Guide done. Press the lobby button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000017
    m_Localized: "Matching"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000018
    m_Localized: "Pick your deck from the list on the right"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000019
    m_Localized: "Test your skills against other players"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000020
    m_Localized: "Or practice against bots"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000021
    m_Localized: "You can go on adventures too"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000022
    m_Localized: "Menu"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000023
    m_Localized: "The menu opens your profile, friends, appearance, chests and settings."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000024
    m_Localized: "Tutorial complete"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000025
    m_Localized: "Next"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000026
    m_Localized: "Done"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000027
    m_Localized: "Press the Deck button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000029
    m_Localized: "Press the Magic Book button"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000030
    m_Localized: "Tap any spell"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000031
    m_Localized: "Read the spell description"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000032
    m_Localized: "The chart shows element matchups"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000033
    m_Localized: "Tap where the spell should land"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000035
    m_Localized: "Casting failed. Try an outlined card"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000036
    m_Localized: "Cast a spell with an outlined card"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000037
    m_Localized: "Tap the mana bar to open your cards"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000038
    m_Localized: "Try a practice match against a bot"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000039
    m_Localized: "Press the bot match button to play your first match"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000040
    m_Localized: "First match done! Now play as you like"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000041
    m_Localized: "Pick a deck or make a new one here"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000042
    m_Localized: "Cards in this deck. Press one to take it out"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000043
    m_Localized: "Your cards. Press one to put it in the deck"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000044
    m_Localized: "Each card shows the mana it costs"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000045
    m_Localized: "Changed your deck? Save it here"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000046
    m_Localized: "Long ago, a great archmage lived on the continent of Wid."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000047
    m_Localized: "Ten thousand years ago, the World Tree grew where he died."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000048
    m_Localized: "And now, a gate to another dimension has opened."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000049
    m_Localized: "Attack."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000050
    m_Localized: "Destroy the enemy before you."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000051
    m_Localized: "Everyone, fall back!\nProtect the World Tree!"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000052
    m_Localized: "And so, war began on the continent of Wid."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000053
    m_Localized: "Keep going."
    m_Metadata:
      m_Items: []
  - m_Id: 318000000054
    m_Localized: "Skip"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000055
    m_Localized: "Click / Space to continue"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000056
    m_Localized: "Start tutorial"
    m_Metadata:
      m_Items: []
