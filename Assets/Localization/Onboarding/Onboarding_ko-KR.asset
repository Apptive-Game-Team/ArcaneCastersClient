--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Onboarding_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: b5ac3a473b3a4861826623f6cd9603af, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 318000000001
    m_Localized: "튜토리얼을 해 볼까요?"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000002
    m_Localized: "처음이라면 짧게 안내해 드릴게요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000003
    m_Localized: "네"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000004
    m_Localized: "아니요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000005
    m_Localized: "덱"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000007
    m_Localized: "덱은 카드 15장으로 짜요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000009
    m_Localized: "덱을 저장해야 다른 화면으로 갈 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000011
    m_Localized: "저장했어요. 로비 버튼을 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000012
    m_Localized: "마법서"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000013
    m_Localized: "마법서에서 마법을 자세히 볼 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000014
    m_Localized: "풀씨 슬라임을 예로 살펴볼게요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000015
    m_Localized: "속성표 버튼을 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000016
    m_Localized: "마법서 안내가 끝났어요. 로비 버튼을 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000017
    m_Localized: "매칭"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000018
    m_Localized: "오른쪽 목록에서 쓸 덱을 고를 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000019
    m_Localized: "다른 사람과 겨뤄 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000020
    m_Localized: "봇과 편하게 연습할 수도 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000021
    m_Localized: "모험도 즐길 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000022
    m_Localized: "메뉴"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000023
    m_Localized: "메뉴에서 옵션과 프로필을 볼 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000024
    m_Localized: "튜토리얼을 마쳤어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000025
    m_Localized: "다음"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000026
    m_Localized: "완료"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000027
    m_Localized: "덱 버튼을 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000029
    m_Localized: "마법서 버튼을 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000030
    m_Localized: "아무 마법이나 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000031
    m_Localized: "마법 설명을 읽어 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000032
    m_Localized: "속성표에서 상성을 볼 수 있어요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000033
    m_Localized: "마법을 쓸 자리를 눌러 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000035
    m_Localized: "시전이 안 되고 있어요. 강조된 카드를 골라 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000036
    m_Localized: "테두리가 빛나는 카드로 마법을 써 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000037
    m_Localized: "마나 바를 눌러 카드 창을 열어 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000038
    m_Localized: "봇과 연습해 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000039
    m_Localized: "봇과 연습 버튼을 눌러 첫 경기를 해 보세요"
    m_Metadata:
      m_Items: []
  - m_Id: 318000000040
    m_Localized: "첫 경기를 마쳤어요! 이제 자유롭게 즐겨 보세요"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
