    m_Localized: "Builds a cannon of the human magic civilization that shells ground units."
    m_Metadata:
      m_Items: []
  - m_Id: 1000004
    m_Localized: "Builds a human anti-air arcane tower that deals area damage to flying units."
    m_Metadata:
      m_Items: []
