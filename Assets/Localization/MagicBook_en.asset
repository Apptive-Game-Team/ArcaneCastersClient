    m_Localized: "Summons a swarm of surviving water slimes that leave a water field in their wake."
    m_Metadata:
      m_Items: []
  - m_Id: 1000001
    m_Localized: "Fires a hellfire projectile in the target direction."
    m_Metadata:
      m_Items: []
  - m_Id: 1000002
    m_Localized: "Erupts a geyser that damages enemies and launches them into the air."
    m_Metadata:
      m_Items: []
