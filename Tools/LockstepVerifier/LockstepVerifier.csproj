<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);WINDOWS;CHECKMATH</DefineConstants>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../LocalPackages/com.arcanecasters.lockstep/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
